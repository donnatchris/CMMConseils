         $_.MaxRandomTime.Seconds -eq 5 -and
                      $_.MaxRandomTime.Milliseconds -eq 477) {
                      “Infinite ([TimeSpan]::MaxValue)”
                  } else {
                      $_.MaxRandomTime.ToString()
                  }
                </ScriptBlock>
                <Label>MaxTemporaryDesyncTime</Label>
              </ListItem>
              <ListItem>
                <PropertyName>DeadGatewayDetection</PropertyName>
              </ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>

