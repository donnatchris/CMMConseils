                retVal = retVal.replace(/\n/g, " "); // newline characters
                retVal = retVal.replace(/ +(?= )/g, ""); // remove multiple spaces
            }

            return retVal;
        }

        this.stripHtml = function (str) {
            var retVal = str;

            if (retVal) {
                retVal = sanitizer.stripHtml(retVal);
            }

            return retVal;
        }
    }

    EventBase.Name = "generic_event";

    EventBase.prototype.GenerateEventMetadata = function(scope) {
        console.log("GenerateEventMetadata called from eventBase");
        return {};
    }

    // Each derived event should fill in this.props in order to trigger tealium event
    EventBase.prototype.trigger = function () {
        analytics.event(this.props);
    }

    return EventBase;
});
define('SageDotCom/DataLayer/Events/exitLinkClick',["jquery", "SageDotCom/DataLayer/Events/eventBase"], function ($, EventBase) {

    function ExitLinkClickEvent() {
        EventBase.call(this); // inherit eventBase
        this.name = "exit_click"; // overwrite name
    }

    ExitLinkClickEvent.prototype = Object.create(EventBase.prototype);

    ExitLinkClickEvent.prototype.GenerateEventMetadata = function GenerateEventMetadata(scope, label) {
        var eventData = {
            'event_name': this.getName(),
            'event_non-int': "0",
            'event_category': "engagement",
            'event_action': "external link"
        }

        if (scope) {
            if ($(scope).hasClass("commerce-login")) {
                if (window.utag_data) {

                    let utagData = window.utag_data;

                    eventData = {
                        "site_environment": utagData.site_environment || "",
                        "site_platform": utagData.site_platform || "",
                        "event_name": "checkout_log_in_click",
                        "site_currency": utagData.site_currency || "",
                        "page_type": utagData.page_type || "",
                        "page_section": utagData.page_section || "",
                        "page_id": utagData.page_id === "checkout_spa" ? "Account Details" : utagData.page_id
                    };
                }
            } else {
                var anchorClass = $(scope).attr("class") || "";
                var location = this.getLocation(scope);
                var lbl = label || $(scope).attr("data-title") || $(scope).text() || $("a:first", scope).text() || "";
                var scopeId = this.getId(scope);
                var lev3 = "";
                var lev4 = "";
                if (scopeId) {
                    if (scopeId.indexOf("BV_popover") !== -1) {
                        lev3 = "tooltip_popup";
                        lev4 = "existing sageid";
                    } else if (scopeId.indexOf("alertbox") !== -1) {
                        lev3 = "top_banner_popup";
                        lev4 = "existing sageid";
                    } else {
                        lev3 = "";
                        lev4 = location;
                    }
                }

                eventData = $.extend(eventData, {
                    'event_label': this.stripHtml(lbl.trim()), // strip any html
                    'event_name_level_1': this.getId(scope),
                    'event_name_level_2': $(scope).attr("href") || $("a:first", scope).attr("href") || "",
                    'event_name_level_3': lev3,
                    'event_name_level_4': lev4
                });

                if (anchorClass && anchorClass.indexOf("existing-user-link") >= 0) {
                    eventData = $.extend(eventData, {
                        'page_name': "try"
                    });
                }
            }
        }
        return eventData;
    }

    return new ExitLinkClickEvent();
});
define('SageDotCom/DataLayer/Events/buttonClick',["jquery", "SageDotCom/DataLayer/Events/eventBase"], function ($, EventBase) {

