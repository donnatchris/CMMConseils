                tealium.event(eventObj);
            });

            eventManager.subscribe("funnelback-results-rendered", function(scope) {
                $(".result a", scope).click(function (event) {
                    var searchTerm = getTerm("searchterm");
                    var searchFacets = getFacets("searchfacets");

                    var eventObj = selectionEvent.GenerateEventMetadata(event.currentTarget, searchTerm, searchFacets);
                    tealium.event(eventObj);
