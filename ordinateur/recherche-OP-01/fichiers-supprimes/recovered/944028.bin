    function EventBase() {
        this.name = "generic_event";

        this.getName = function () {
            return this.name;
        }

        this.getLocation = function (scope) {
            var location = $(scope).closest("header").length ? "header" : $(scope).closest("footer").length ? "footer" : "body";

            if (location === "body") {
                var parent = $(scope).parent().closest("[id]");


                var component = !parent.attr("class") ? null : parent.attr("class").split(" ").find(function (value) {
                    return /^score/.test(value);
                });

                if (component) {
                    location += " > " + component.replace(/score/i, "").replace(/\-/gi, " ").trim();
                }

            }

            return location;
        }

        this.getId = function (scope) {

            // Check if the scope itself has an id
            var scopeId = $(scope).attr("id");
            if (scopeId && scopeId !== "") {
                return scopeId;
            }

            var elem = $(scope).closest("[id]");

            if (elem) {
                return elem.attr("id");
            }

            return "";
        }

        this.getLanguage = function () {
            return document.documentElement.lang;
        }

        this.cleanseString = function(str) {
            var retVal = str;

            if (retVal) {
