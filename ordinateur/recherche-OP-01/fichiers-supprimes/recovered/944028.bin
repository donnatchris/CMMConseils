                                    analytics.event(data);
                                });
                                componentRegistrations.push({ obj: component, name: internalLinkEvent.getName() });
                            }
                        } else { // external URL
                            $(value).on('click', function (event) {
                                var data = exitLinkEvent.GenerateEventMetadata(event.currentTarget);
                                analytics.event(data);
                            });
                            componentRegistrations.push({ obj: component, name: exitLinkEvent.getName() });
                        }
                    }
                });

            componentRegistrations.forEach(function(elem) {
                trackingHelper.registerTracking(elem.obj, elem.name);
            });

            // track anchors across commerce module accordingly
            $(".commerce-page").find('a').each(function (key, value) {
                value.addEventListener('click', onLinkClick);
            });
        }

        function onLinkClick(e) {
            var link = e.currentTarget;
            var component = link.closest("[id]");

            // Skip tracking if component have already explicit tracking attribute
            if (component.hasAttribute("data-tracking") || component.hasAttribute("data-xpr-state") || link.hasAttribute("data-tracking") || link.hasAttribute("data-xpr-state")) return;

            var data;
            // internal URL?  only if hostname is blank or matches current browser URL
            if (!link.hostname || !link.hostname.length || location.hostname.toLowerCase() === link.hostname.toLowerCase()) {
                // handle file download vs internal link click
                var fileTester = urlHelper.isFile(link.href);
                if (fileTester.isFile === true && fileTester.fileName) {
                    data = fileDownloadEvent.GenerateEventMetadata(link, fileTester.fileName);
                } else {
                    data = internalLinkEvent.GenerateEventMetadata(link);
                }
            } else { // external URL
                data = exitLinkEvent.GenerateEventMetadata(link);
            }

            analytics.event(data);
        }

        return new globalLinkTracking();
    });
define('SageDotCom/DataLayer/Events/top-nav-interaction',[
