                    });
                });
                $(form).find(':checkbox').each(function (index, checkbox) {
                    $(checkbox).focus(function () {
                        captureFormStart(form, checkbox);
                    });

                    componentRegistrations.push({ obj: checkbox, name: fieldCompletion.getName() });

                    $(checkbox).change(function (event) {
                        var data = fieldCompletion.GenerateEventMetadata($(event.currentTarget));
                        analytics.event(data);
                    });
                });
                $(form).find('.select-all, .deselect-all').each(function (index, btn) {
                    $(btn).focus(function () {
                        captureFormStart(form, btn);
                    });

                    componentRegistrations.push({ obj: btn, name: fieldCompletion.getName() });

                    $(btn).click(function (event) {
                        var data = fieldCompletion.GenerateEventMetadata($(event.currentTarget));
                        analytics.event(data);
                    });
                });
                $(form).find('input[type=radio]').each(function (index, radio) {
                    componentRegistrations.push({ obj: radio, name: fieldCompletion.getName() });

                    $(radio).change(function (event) {
                        captureFormStart(form, radio);

                        var data = fieldCompletion.GenerateEventMetadata($(event.currentTarget));
                        analytics.event(data);
                    });
                });
            });

            componentRegistrations.forEach(function (elem) {
                trackingHelper.registerTracking(elem.obj, elem.name);
            });
        }

        return new globalFormTracking();
    });

