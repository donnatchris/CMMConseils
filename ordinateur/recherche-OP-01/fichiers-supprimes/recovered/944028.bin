   numbersCountUp.prototype.initialize = function() {

     //Animated numbers Count-Up
     if ($(".number-count-up").length) {

       // inserts classes for all elements inside the component that contains a number
       $(".number-count-up").find('*').each(function() {
         var num = $(this).text();
