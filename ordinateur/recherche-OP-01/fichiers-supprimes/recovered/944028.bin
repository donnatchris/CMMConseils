    TopNavInteractionEvent.prototype = Object.create(EventBase.prototype);

    return TopNavInteractionEvent;
});
define('SageDotCom/DataLayer/Events/top-nav-select',[
    "jquery",
    "SageDotCom/DataLayer/Events/eventBase",
    "SageDotCom/PolyFills/closest"
], function ($, EventBase) {

    function TopNavSelectEvent(link) {
        EventBase.call(this);
        
        var topMenuItem = link.closest('li.open');
        
        this.props = {
            "event_name": "top_nav_select",
            "event_non-int ": "0", 
            "event_category": "component", 
            "event_action": "top_nav_select",
            "event_label": this.getEventLabel(link), // title of clicked menu item
            "event_name_level_1": this.getId(link), // element id of clicked menu item
            "event_name_level_2": link.href, // url
            "event_name_level_3": topMenuItem && topMenuItem.firstElementChild ? this.cleanseString(topMenuItem.firstElementChild.text) : "", // top menu title
            "event_name_level_4": this.getSubMenuTitle(link) // sub menu title
        }
    }

    TopNavSelectEvent.prototype = Object.create(EventBase.prototype);

    TopNavSelectEvent.prototype.constructor = TopNavSelectEvent;

    TopNavSelectEvent.prototype.getEventLabel = function (link) {
        var label = '';

        // if the text inside the link has a '/' then we need to look somewhere else for the label
        // Try to get nearest label
        var labelEl = this.findTagByParentChildAndDepth($(link), 'div', 'caption', 'h2', 3);
        if (labelEl != null) {
            var itemLabel = labelEl.text();
            label = this.cleanseString(itemLabel);
        }

        // Grab the text inside the link if nothing else is found
        if (label === '') {
            // some of the links contain p tags and then a span tag to give more info within a 
            // anchor tag and in that case grab the text from the p tag only
            if ($(link).find('p').length)
                label = this.cleanseString($(link).find('p').text())
            else
                label = this.cleanseString(link.text);
        }
        
        return label;
    }

    TopNavSelectEvent.prototype.getSubMenuTitle = function (link) {

        var title = '';

        // Try to get nearest sub title
        var subMenuTitleEl = this.findTagByParentAndChild($(link), 'div', 'h3');
        if (subMenuTitleEl != null) {
            var subHeading = subMenuTitleEl.text();
            title = this.cleanseString(subHeading);
        }

        if (!title) {
            var container = $(link).closest('[class^="score-column"], [class^="score-left"], [class^="score-center"], [class^="score-right"]')[0];

            if (container) {
                title = $('h3', container).text();
            }
        }

        if (!title) {
            var heading = $(link).closest('h3').text();
            title = this.cleanseString(heading);
        }

        return title; 
    }

    TopNavSelectEvent.prototype.getMenuTitle = function (link) {
        return this.cleanseString(link.text);
    }

    // This will recurse up the tree from the original element and stop at each parentNode
    // to first determine if the tag name given is the same as the parent then it will look 
    // at the child nodes of that parent to see if it can find the child tag name and if it can
    // it will return that element else it will return null
    TopNavSelectEvent.prototype.findTagByParentAndChild = function (el, parentTag, childTag) {
        while (el.parent().length) {
            el = el.parent().first(); 
            var parentNodeName = el[0].nodeName;
            if (parentNodeName.toLowerCase() === parentTag.toLowerCase()) {
                // This pulls out the first child it finds that has the child tag
                if (el.find(childTag).length) {
                    return el.find(childTag).first();
                }
            }
        }
    }

    // This will recurse up the tree from the original element and stop at each parentNode
    // to first determine if the tag name given is the same and if the class name exists as well
    // but it will only go as high as needed so it doesn't find a false positive.   It will then
    // look for the child items and if that is found then it will return that data
    TopNavSelectEvent.prototype.findTagByParentChildAndDepth = function (el, parentTag, parentClassName, childTag, numlevels) {
        var deepCount = 0
        while (el.parent().length) {

            // break out of the loop if you reached the depth needed
            if (deepCount >= numlevels) {
                break;
            }

            el = el.parent().first();
            var parentNodeName = el[0].nodeName;
            var hasClassName = el[0].className.toLowerCase().indexOf(parentClassName) > -1;
            if (parentNodeName.toLowerCase() === parentTag.toLowerCase() && hasClassName) {
                // This pulls out the first child it finds that has the child tag
                if (el.find(childTag).length) {
                    return el.find(childTag).first();
                }
            }

            deepCount++;
        }
    }

    return TopNavSelectEvent;
});
define('SageDotCom/DataLayer/Global/header-menu-tracker',[
    "jquery",
    "SageDotCom/DataLayer/Events/top-nav-interaction",
    "SageDotCom/DataLayer/Events/top-nav-select",
],
function ($, TopNavInteractionEvent, TopNavSelectEvent) {
    
    function HeaderMenuTracker() {
        this.scope = document.querySelectorAll('header nav.score-megamenu, header .score-button-group:not(nav.score-megamenu *)');
    }

    HeaderMenuTracker.prototype.start = function () {
        // Disable tracking in case if site header is not presented on the page
        if (!(this.scope && this.scope.length > 0)) return;

        // Track expanding of dropdown menus
        $(".score-megamenu-dropdown", this.scope).on("show.bs.dropdown", onDropdownMenuExpand);
        $(".modal-launch-btn:not(nav.score-megamenu .score-button-group *):first", this.scope).on("click", onLoginButtonClick);

        // Track clicking on basic menu item
        $(".score-megamenu-basic-item", this.scope).on("click", onBasicMenu);

        // Track clicking on back button
        $(".back-button", this.scope).on("click", onBackBtnClick);

        // Track expanding of mobile menu(hamburger)
        $(".navbar-collapse", this.scope).on("show.bs.collapse", onMobileMenuExpand.bind(this));

        // Track expanding of search suggestions

        for (var i = 0; i < this.scope.length; i++) {
            var searchResultsMenu = this.scope[i].querySelector(".tt-menu");
            if (searchResultsMenu) {
                var observer = new MutationObserver(onSearchSuggestionsExpand.bind(searchResultsMenu));
                observer.observe(searchResultsMenu, { attributes: true });
            }
        }

        // Track click on links in menu and search suggestions that navigate to new page
        $(this.scope).on("click", "a[href]:not([href^='#'])", onLinkClick);
        $(".login-modal").on("click", "a[href]:not([href^='#'])", onLinkClick);
    }

    function onDropdownMenuExpand(e) {
        var el = e.currentTarget;
        var label = e.currentTarget.querySelector("button, a").innerText;
        new TopNavInteractionEvent(el, label).trigger();
    }

    function onLoginButtonClick(e) {
        var el = e.currentTarget;
        var label = e.currentTarget.text;
        new TopNavInteractionEvent(el, label).trigger();
    }

    function onBackBtnClick(e) {
        var el = e.currentTarget;
        var label = e.currentTarget.innerText;
        new TopNavInteractionEvent(el, label).trigger();
    }

    function onBasicMenu(e) {
        var el = e.currentTarget;
        var label = e.currentTarget.querySelector("a").text;
        new TopNavInteractionEvent(el, label).trigger();
    }

    function onMobileMenuExpand(e) {
        var toggleMenuButton = this.scope[0].querySelector('[data-target*="' + e.currentTarget.id + '"]');
        var label = 'expand mobile menu';
        new TopNavInteractionEvent(toggleMenuButton, label).trigger();
    }

    function onSearchSuggestionsExpand(e) {
        if (this.style.display == 'block') {
            var label = "expand search suggestions";
            new TopNavInteractionEvent(this, label).trigger();
        }
    }

    function onLinkClick(e) {
        var isSearchSuggestionLink = e.currentTarget.parentElement.classList.contains('tt-suggestion');
        var isLoginButton = $(e.currentTarget).is(".modal-launch-btn:not(nav.score-megamenu .score-button-group *):first");
        // Trigger top_nav_select event for menu links only excluding search suggestion links
        if (!isSearchSuggestionLink && !isLoginButton) {
            new TopNavSelectEvent(e.currentTarget).trigger();
        }
    }

    return HeaderMenuTracker;
});
define('SageDotCom/DataLayer/Events/carouselCustomerStory',['jquery', 'SageDotCom/DataLayer/Events/eventBase'], function ($, EventBase) {

    function CustomerStoryCarousel() {
        EventBase.call(this); // inherit eventBase
        this.name = 'customer_story_int'; // overwrite name
    }

    CustomerStoryCarousel.prototype = Object.create(EventBase.prototype);

    CustomerStoryCarousel.prototype.GenerateEventMetadata = function GenerateEventMetadata(scope, label, menu) {
        // generate event object based on data from the component
        var lbl = label || $(scope).attr('data-title') || $(scope).text() || $('a:first', scope).text() || '(not set)';
        lbl = this.cleanseString(lbl);
        menu = this.cleanseString(menu);
        var id = this.getId(scope);
        var location = this.getLocation(scope);

        // business_select schema defined in tealium
        var eventObj = {
            'event_name': this.name,
            'event_non-int': '0',
            'event_category': 'component',
            'event_action': this.name,
            'event_label': lbl,
            'event_name_level_1': id,
            'event_name_level_2': lbl,
            'event_name_level_3': menu || '(not set)',
            'event_name_level_4': location
        };

        return eventObj;
    }

    return new CustomerStoryCarousel();
});
