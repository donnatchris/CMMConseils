define('SageDotCom/DataLayer/Events/video-interaction',[
    'SageDotCom/DataLayer/Events/eventBase'
], function (EventBase) {

    function VideoInteractionEvent(player, isMilestoneEvent) {
        EventBase.call(this);

        this.props = {
            'event_name': 'video_int',
            'event_non-int': '0',
            'event_category': 'engagement',
            'event_action': 'video',
            'event_label': isMilestoneEvent ? 'milestone' : getStateLabel(player),
            'event_name_level_1': getVideoId(player),
            'event_name_level_2': getMilestone(player, isMilestoneEvent),
            'event_name_level_3': getVideoTitle(player),
            'event_name_level_4': '(not set)'
        };
    }

    VideoInteractionEvent.prototype = Object.create(EventBase.prototype);

    function getStateLabel(player) {
        if (player.isYoutube) {
            switch (player.getPlayerState()) {
            case YT.PlayerState.PLAYING:
                return 'play';
            case YT.PlayerState.PAUSED:
                return 'pause';
            case YT.PlayerState.ENDED:
                return 'end';
            default:
                return '(not set)';
            }
        }
        else if (player.isBrightcove) {
            switch (player.eventType) {
                case "play":
                    return "play";
                case "pause":
                    return "pause";
                case "ended":
                    return "end";
                case "milestone":
                    return "milestone";
                default:
                    return "(not set)";
            }
        }
        else {
            return player.tracking.eventType;
        }
    }

    function getVideoId(player) {
        if (player.isYoutube) {
            return player.getIframe().id;
        }
        else if (player.isBrightcove) {
            return player.videoId;
        }
        else {
            return player.tracking.id;
        }
    }

    function getVideoTitle(player) {
        if (player.isYoutube) {
            return player.getVideoData().title;
        }
        else if (player.isBrightcove) {
            return player.videoTitle;
        }
        else {
            return player.tracking.title;
        }
    }

    function getMilestone(player, isMilestoneEvent) {
        if (isMilestoneEvent) {
            if (player.isBrightcove) {
                return player.milestone;
            }
            else {
                return player.tracking.milestone.toString();
            }
        }
        else {
            return '(not set)';
        }
    }

    return VideoInteractionEvent;
});
define('SageDotCom/DataLayer/Global/generic-video-tracker',[
    "jquery",
    "SageDotCom/DataLayer/Events/video-interaction"
],
function ($, VideoInteractionEvent) {

    // Possible milestones
    var milestones = [0, .25, .5, .75, 1];

    function GenericVideoTracker() {
    }

    function getCurrentMilestone(player) {
        var elapsedTime = player.currentTime / player.duration;

        // Get milestone index that matches elapsed time
        var milestone = _.findLastIndex(milestones, function (m) { return elapsedTime >= m; });

        return milestone;
    }

    function trackMilestoneEvents() {
        var milestone = getCurrentMilestone(this);
        var lastMilestone = this.tracking.milestone != undefined ? this.tracking.milestone : -1;
        
        // Raise analytics event if new milestone reached
        if (milestone > lastMilestone) {
            this.tracking.milestone = milestone;
            new VideoInteractionEvent(this, true).trigger();
        }
    }

    function onPlay() {
        this.tracking.milestoneIntervalId = setInterval(trackMilestoneEvents.bind(this), 500);
        this.tracking.eventType = "play";
        new VideoInteractionEvent(this).trigger();
    }

    //When the video is paused or ends
    function onPause() {
        var milestone = getCurrentMilestone(this);

        if (milestones[milestone] === 1) {
            //video has ended
            this.tracking.milestone = milestone;
            new VideoInteractionEvent(this, true).trigger();
            this.tracking.eventType = "end";
        } else {
            //video was paused
            this.tracking.eventType = "pause";
        }
        new VideoInteractionEvent(this).trigger();
        clearInterval(this.tracking.milestoneIntervalId);
    }

    function trackVideosIn(container) {
        // only set up tracking on video tags that are not inside a score brightcove video component
        var players = $(container).find("video").not(function () {
            return $(this).parents(".score-brightcove-video") !== null && $(this).parents(".score-brightcove-video").length > 0;
        });

        players.each(function (index, player) {
            if (player) {
                player.isYoutube = false;
                player.tracking = player.tracking || {};
                player.tracking.id = player.id;
                player.tracking.title = player.title;
                $(player).on("play", onPlay);
                $(player).on("pause", onPause);
            }
        });
    }

    GenericVideoTracker.prototype.start = function () {
        // Track state of all youtube players when youtube api loaded
        $(function () {
            trackVideosIn(document.body);
        });
    }

    return GenericVideoTracker;
});
define('SageDotCom/DataLayer/Events/ga4-video-interaction',[
    "SageDotCom/DataLayer/Events/eventBase"
], function (eventBase) {

    function ga4VideoInteractionEvent(player, isMilestoneEvent, isSeekEvent, isVideoStartEvent) {
        eventBase.call(this);

        if (player.isYoutube) {
            if (isYouTubePlayerReady(player)) {
                this.props = {
                    "event": "video",
                    "video_status": isMilestoneEvent ? "milestone" : getYouTubeStateLabel(player, isSeekEvent, isVideoStartEvent),
                    "video_title": player.getVideoData().title,
                    "video_id": player.getVideoData().video_id,
                    "video_provider": "youtube",
                    "video_duration": Math.floor(player.getDuration()).toString(),
                    "video_current_time": Math.floor(player.getCurrentTime()).toString(),
                    "milestone_in_%": getMilestoneInPercent(player),
                    "display_method": "embeded"
                };
            }            
        }
        else {
            //must be brightcove
            this.props = {
                "event": "video",
                "video_status": getBrightcoveStateLabel(player),
                "video_title": player.videoTitle,
                "video_id": player.videoId,
                "video_provider": "brightcove",
                "video_duration": player.duration.toString(),
                "video_current_time": player.currentTime.toString(),
                "milestone_in_%": player.milestone.toString(),
                "display_method": "embeded"
            };
        }
    }

    ga4VideoInteractionEvent.prototype = Object.create(eventBase.prototype);

    function getBrightcoveStateLabel(player) {
        switch (player.eventType) {
            case "play":
                return "play";
            case "pause":
                return "pause";
            case "ended":
                return "end";
            case "seeked":
                return "seek";
            case "milestone":
                return "milestone";
            case "firstplay":
                return "video_start";
            default:
                return "(not set)";
        }
    }

    function getYouTubeStateLabel(player, isSeekEvent, isVideoStartEvent) {
        if (isVideoStartEvent) {
            return "video_start";
        }
        if (isSeekEvent) {
            return "seek";
        }
        if (!isYouTubePlayerReady(player)) {
            return "(not set)";
        }
        switch (player.getPlayerState()) {
            case YT.PlayerState.PLAYING:
                return "play";
            case YT.PlayerState.PAUSED:
                return "pause";
            case YT.PlayerState.ENDED:
                return "end";
            default:
                return "(not set)";
        }
    }

    function getMilestoneInPercent(player) {
        if (!isYouTubePlayerReady(player)) {
            return "0";
        }

        if (player.getPlayerState() === YT.PlayerState.ENDED) {
            return "100";
        }

        if (
            !player.tracking ||
            !player.tracking.ga4MilestonesDecimalValues
        ) {
            return "0";
        }

        return (
            player.tracking.ga4MilestonesDecimalValues[player.tracking.ga4Milestone] * 100
        ).toString();
    }

    function isYouTubePlayerReady(player) {
        return !!(
            player &&
            typeof player.getCurrentTime === "function" &&
            typeof player.getDuration === "function" &&
            typeof player.getPlayerState === "function" &&
            typeof player.getVideoData === "function"
        );
    }

    return ga4VideoInteractionEvent;
});
define('SageDotCom/DataLayer/Global/brightcove-video-tracker',[
    "jquery",
    "SageDotCom/DataLayer/Events/video-interaction",
    "SageDotCom/DataLayer/Events/ga4-video-interaction",
    "eventManager"

],
    function ($, VideoInteractionEvent, Ga4VideoInteractionEvent, eventManager) {

        function BrightcoveVideoTracker() {
        }

        function onPlayerEventDetected(playerDetails) {

            if (playerDetails.eventType === "play" && playerDetails.currentTime === 0) {
                //The video began playing for the first time or after 100% play completion ("video_start" event)
                new VideoInteractionEvent(playerDetails, false).trigger();
                playerDetails.eventType = "firstplay";
                new Ga4VideoInteractionEvent(playerDetails, false, false, true).trigger();
            }
            else if (playerDetails.eventType === "seeked") {
                new Ga4VideoInteractionEvent(playerDetails, false, true, false).trigger();
            }
            else if (playerDetails.eventType === "milestone" && playerDetails.milestone !== 0) {
                new VideoInteractionEvent(playerDetails, true).trigger();
                new Ga4VideoInteractionEvent(playerDetails, true, false, false).trigger();
            }
            else if (playerDetails.eventType === "play" || playerDetails.eventType === "pause" || playerDetails.eventType === "ended") {
                // brightcove sends extra pause event at the end of a video which is not wanted for our tracking
                if (!(playerDetails.eventType === "pause" && playerDetails.currentTime === playerDetails.duration)) {
                    new VideoInteractionEvent(playerDetails, false).trigger();
                    new Ga4VideoInteractionEvent(playerDetails, false, false, false).trigger();
                }
            }
        }

        function populateEventDetails(player, eventType) {
            var playerInfo = {
                state: player.paused() ? 'paused' : 'playing',
                eventType: eventType,
                currentTime: player.currentTime(),
                duration: player.duration(),
                muted: player.muted(),
                videoId: player.mediainfo.id,
                videoName: player.mediainfo.name,
                videoTitle: player.mediainfo.name,
                videoUrl: player.currentSrc(),
                milestone: eventType === "ended" ? "100" : calculateMilestone(player),
                isBrightcove: true,
                volume: Math.round(player.volume() * 100)
            };

            onPlayerEventDetected(playerInfo);
        }

        function fireMilestoneEvent(player) {
            var previouslyReachedMilestone = player.milestoneTrackingMilestone !== undefined ? player.milestoneTrackingMilestone : -1;
            var milestone = calculateMilestone(player);

            if (milestone > previouslyReachedMilestone) {
                // new milestone reached so send milestone event
                player.milestoneTrackingMilestone = milestone;
                populateEventDetails(player, "milestone");
            }
            else {
                player.milestoneTrackingMilestone = previouslyReachedMilestone;
            }
        }

        function calculateMilestone(player) {
            var milestones = [0, .1, .25, .5, .75, .9];
            const isMilestone = (m) => (player.currentTime() / player.duration()) >= m;
            var milestoneIndex = milestones.findLastIndex(isMilestone);
            return (milestones[milestoneIndex]) * 100;
        }

        function trackBrightcoveVideosIn(container) {

            // The event should only be fired after the window has received the 'load' event; otherwise, it may cause an error
            window.onload = function () {

                // for setting up tracking on the scrore brightcove videos
                if ($('.brightcove-media-container-js') !== null && $('.brightcove-media-container-js').length > 0) {
                    for (var i = 0; i < Object.keys(videojs.getPlayers()).length; i++) {
                        var playerId = Object.keys(videojs.players)[i];
                    
                        // Define the ready event for the player
                        var player = videojs.getPlayer(playerId);

                        player.on("firstplay", function (event) {
                            populateEventDetails(event.target.player, "firstplay");
                        });
                        player.on("play", function (event) {
                            populateEventDetails(event.target.player, "play");
                        });
                        player.on("pause", function (event) {
                            populateEventDetails(event.target.player, "pause");
                        });
                        player.on("ended", function (event) {
                            populateEventDetails(event.target.player, "ended");
                        });
                        player.on("seeked", function (event) {
                            populateEventDetails(event.target.player, "seeked");
                        });
                        player.on("timeupdate", function (event) {
                            // make sure that it only fires when event comes from video element, not progress bar like after seek event
                            if (event.target.tagName === "DIV" && event.target.classList.contains("video-js")) {
                                fireMilestoneEvent(event.target.player);
                            }
                        });
                    }
                }
            };
            
        }

        BrightcoveVideoTracker.prototype.start = function () {

            trackBrightcoveVideosIn(document.body);
        }

        return BrightcoveVideoTracker;
    });
define('SageDotCom/DataLayer/Events/Ccaas/ccaasEvent',[
        "jquery",
        "SageDotCom/DataLayer/Events/eventBase"
    ],
    function ($, EventBase) {
        function CcaaSEvent(chatUniqueId, action, category, label, name, level2, level3, level4) {
            EventBase.call(this);

            const eventAction = action;
            const eventCategory = category || "component";
            const eventLabel = label;
            const eventName = name;
            const eventLevel1 = chatUniqueId || "chat-console";
            const eventLevel2 = level2 || "";
            const eventLevel3 = level3;
            const eventLevel4 = level4;

            this.props = {
                'event_action': eventAction,
                'event_category': eventCategory,
                'event_label': eventLabel,
                'event_name': eventName,
                'event_name_level_1': eventLevel1,
                'event_name_level_2': eventLevel2,
                'event_name_level_3': eventLevel3,
                'event_name_level_4': eventLevel4,
                'event_non-int': "0"
            };
        }

        CcaaSEvent.prototype = Object.create(EventBase.prototype);
        return CcaaSEvent;
    });
define('SageDotCom/DataLayer/Events/Ccaas/ccaasTracking',[
        "SageDotCom/DataLayer/Events/eventBase"
    ],
    function (EventBase) {
        function CcaasTracking(eventName) {
            EventBase.call(this);

            this.props = {
                'event': "genesys",
                'event_name': eventName,
                'chat_name': "genesys"
            };
        }
        CcaasTracking.prototype = Object.create(EventBase.prototype);
        return CcaasTracking;
    });
define('SageDotCom/DataLayer/Events/Ccaas/ccaasAltEvent',[
        "jquery",
        "SageDotCom/DataLayer/Events/eventBase"
    ],
    function ($, EventBase) {
        function CcaaSAltEvent(action, category, label, name, level1, level2, level3, level4, nonInt, trigger) {
            EventBase.call(this);

            const eventAction = action;
            const eventCategory = category;
            const eventLabel = label;
            const eventName = name;
            const eventTrigger = trigger;
            const eventLevel1 = level1;
            const eventLevel2 = level2;
            const eventLevel3 = level3;
            const eventLevel4 = level4;
            const eventNonInt = nonInt || "0";

            this.props = {
                'event_action': eventAction,
                'event_category': eventCategory,
                'event_label': eventLabel,
                'event_name': eventName,
                'event_name_level_1': eventLevel1,
                'event_name_level_2': eventLevel2,
                'event_name_level_3': eventLevel3,
                'event_name_level_4': eventLevel4,
                'event_non-int': eventNonInt
            };

            if (trigger) {
                this.props.event_trigger = eventTrigger; 
            }
        }
        CcaaSAltEvent.prototype = Object.create(EventBase.prototype);
        return CcaaSAltEvent;
    });
define('SageDotCom/DataLayer/Global/ccaas-chat-tracker',[
    "jquery",
    "SageDotCom/DataLayer/tealium",
    "SageDotCom/DataLayer/Events/Ccaas/ccaasEvent",
    "SageDotCom/DataLayer/Events/Ccaas/ccaasTracking",
    "SageDotCom/DataLayer/Events/buttonClick",
    "SageDotCom/DataLayer/Events/Ccaas/ccaasAltEvent",
    "eventManager"
],
    function ($, tealium, CcaaSEvent, CcaasTracking, buttonClickEvent, CcaasAltEvent, eventManager) {
        const defaultTimeoutValue = 3000;
        const observerTimeoutValue = 60000;
        const ccaasBubbleSelector = ".ccaas-btn, .cs-button, .open-live-chat";
        const startChatButtonSelector = '[aria-label="Start Chat"], [aria-label="Lancer un chat"]';
        const messageInputSelector = ".cx-input-container";
        const ccaasFirstName = "#cx_webchat_form_firstname";
        const ccaasNameInput = "#cx_webchat_form_name";
        const ccaasAccount = "#cx_webchat_form_accountnumber";
        const ccaasSubject = "#cx_webchat_form_subject";
        const ccaasEmail = "#cx_webchat_form_email";
        const ccaasCancel = "div.cx-button-group.cx-buttons-binary button[data-message='ChatFormCancel']";
        const ccaasMinimize = "div.cx-button-group.cx-buttons-window-control button[data-icon='minimize']";
        const ccaasClose = "div.cx-button-group.cx-buttons-window-control button[class='cx-icon cx-button-close']";

        //CCAAS ALT SELECTORS
        const ccaasAltBubbleSelector = ".cx-sidebar-button";
        const ccaasAltCloseIconSelector = ".cx-button-close";
        const ccaasAltMinimizeIconSelector = ".cx-button-minimize";
        const ccaasAltModalFormSendChatSelector = ".cx-webchat";
        const ccaasAltModalFormSendMessageSelector = ".cx-send-message";
        const ccaasAltModalFormEmailSelector = "#cx_sendmessage_form_email";
        const ccaasAltModalFormFirstnameSelector = "#cx_sendmessage_form_firstname";
        const ccaasAltModalFormQuestionSelector = "#cx_sendmessage_form_votre_question";
        const ccaasAltModalFormSendButtonSelector = "button[data-message='Send']";
        const ccaasAltModalFormSendSuccess = ccaasAltModalFormSendMessageSelector;
        const ccaasAltModalFormSendSuccessTextSelector = "*[data-message='Sent']";
        const ccaasAltModalCallBackSelector = ".cx-callback";
        const ccaasAltModalCallBackConfirmButtonSelector = "button[data-message='ConfirmButtonText']";
        const ccaasAltModalCallBackCancelButtonSelector = "button[data-message='CancelButtonText']";
        const ccaasAltModalCallBackDesiredTimeSelector = 'button[class^="cx-callback-time-item"]';
        const ccaasAltModalCallBackPhoneNumberSelector = "#cx_form_callback_phone_number";
        const ccassButtonDiv = ".ccaas-container";

        let liveChatAgentConnected = false;
        let liveChatStartedByAgentOrClient = false;
        let liveChatOpened = false;
        let liveChatEndedByAgent = false;

        function CcaasChatTracker() {
            this.scope = document.querySelector(ccaasBubbleSelector);
        }

        WaitForElement(".genesys-app", function () {
            //Web Messenger Events
            if (window.Genesys !== undefined) {
                new CcaasTracking("live_chat_loaded").trigger();

                window.Genesys("subscribe", "Conversations.opened", function ({ data }) {
                    new CcaasTracking("live_chat_open").trigger();
                });

                window.Genesys("subscribe", "Conversations.started", function ({ data }) {
                    new CcaasTracking("live_chat_started_by_client").trigger();
                });
            }
        }, defaultTimeoutValue);

        //function to wait for ccaas to appear and CXBus to be initialized
        WaitForElement(ccaasBubbleSelector, function () {
            //Universal event for detecting tooltip & firing event
            WaitForElement(".cs-help-tooltip.tooltip-open", function () {
                new CcaasTracking("live_chat_callout_displayed").trigger();
            }, 5000);

            var startTime = Date.now();
            var interval = setInterval(function () {
                if (window.CXBus !== undefined && window.utag !== undefined) {
                    clearInterval(interval);
                    CCaasEventTracking();
                } else {
                    if (Date.now() - startTime > observerTimeoutValue) {
                        clearInterval(interval);
                    }
                }
            }, 250);
        }, observerTimeoutValue);

        function CCaasEventTracking() {
            new CcaasTracking("live_chat_loaded").trigger();

            CXBus.subscribe("WebChatService.messageReceived", function (e) {

                var initiatedBy = ""; // who triggered the event so client or agent
                var eventType = ""; // event type e.g participant left chat or message

                if (e.data) {
                    if (e.data.messages) {
                        if (e.data.messages[0]) {
                            if (e.data.messages[0].from) {
                                if (e.data.messages[0].from.type) {
                                    initiatedBy = e.data.messages[0].from.type;
                                }
                            }
                            if (e.data.messages[0].type) {
                                eventType = e.data.messages[0].type;
                            }
                        }
                    }
                }

                if (initiatedBy != "" && eventType != "") {
                    if (initiatedBy.toLowerCase() == "client" && eventType.toLowerCase() == "message" && liveChatStartedByAgentOrClient == false) {
                        liveChatStartedByAgentOrClient = true;
                        new CcaasTracking("live_chat_started_by_client").trigger();
                    }
                    else if (initiatedBy.toLowerCase() == "agent" && eventType.toLowerCase() == "message" && liveChatStartedByAgentOrClient == false) {
                        liveChatStartedByAgentOrClient = true;
                        new CcaasTracking("live_chat_started_by_agent").trigger();
                    }
                }
            });
            CXBus.subscribe('WebChatService.agentConnected', function (message, agents, numAgentsConnected) {
                if (liveChatAgentConnected == false) {
                    liveChatAgentConnected = true;
                    new CcaasTracking("live_chat_agent_connected").trigger();
                }
            });
            CXBus.subscribe('WebChat.started', function (e) {
                if (liveChatOpened == false) {
                    liveChatOpened = true;
                    liveChatEndedByAgent = false; // after chat started track if its disconnected
                    new CcaasTracking("live_chat_open").trigger();
                }
            });
            CXBus.subscribe('WebChatService.agentDisconnected', function (message, agents, numAgentsConnected) {
                if (liveChatEndedByAgent == false) {
                    liveChatAgentConnected = false;
                    liveChatStartedByAgentOrClient = false;
                    liveChatOpened = false;
                    if (message.data) {
                        if (message.data.message) {
                            if (message.data.message.role && message.data.message.state) {
                                if (message.data.message.role.toLowerCase() == "agent" && message.data.message.state.toLowerCase() == "disconnected") {
                                    //reset back to false as they may open the chat again
                                    liveChatEndedByAgent = true;
                                    new CcaasTracking("live_chat_ended_by_agent").trigger();
               ␀ÿÿ␀␀                 }
                            }
                        }
                    }
                }
            });
        }

        CcaasChatTracker.prototype.start = function () {
            const MutationObserver = window.MutationObserver || window.WebKitMutationObserver;
            WaitForPredictiveEgagement();
            // This will look for CCaaS bubble to exist on the page and once it is found then it will disconnect the observer
            var observer = new MutationObserver(function (mutations, observer) {
                // fired when a mutation occurs
                const ccaasBubble = document.querySelector(ccaasBubbleSelector);
                const ccaasAltBubble = document.querySelector(ccaasAltBubbleSelector);

                if (ccaasBubble) {
                    this.scope = ccaasBubble;
                    $(ccaasBubble).on("click", OnCcaasBubbleClick);

                    // This will disconnect once the element has been found
                    observer.disconnect();
                } else if (ccaasAltBubble) {
                    this.scope = ccaasAltBubble;
                    WaitForElement(ccaasAltBubbleSelector, defaultTimeoutValue);
                    observer.disconnect();
                }
            });

            // define what element should be observed by the observer
            // and what types of mutations trigger the callback
            observer.observe(document,
                {
                    childList: true,
                    characterData: true,
                    subtree: true
                });

            // If after some time has passed (~1 min) automatically disconnect the observer so it will stop looking for the element
            setTimeout(function () {
                observer.disconnect();
            },
                observerTimeoutValue);
        };

        function OnCcaasBubbleClick() {
            //Initiate chat event
            const data = buttonClickEvent.GenerateEventMetadata(event.currentTarget);
            tealium.event(data);

            WaitForElement(ccaasClose, function () {

                //if not FR
                if ($('[aria-label="Start Chat"]').is(":visible")) {
                    //Start Chat button
                    const startChatButton = $(startChatButtonSelector);
                    if (startChatButton == null) return;
                    startChatButton.unbind("click").on("click", OnStartChatButtonClick);

                    //First name completed
                    //Adaptation for different input ids
                    var nameInput = document.querySelector(ccaasFirstName);
                    if (nameInput == null) {
                        nameInput = document.querySelector(ccaasNameInput);
                        if (nameInput == null) return;
                    }

                    const firstName = nameInput;
                    this.scope = firstName;

                    $(firstName).off("focusout").on("focusout", function () {
                        if (firstName.className === "cx-input cx-form-control" && firstName.value.length > 0) {
                            new CcaaSEvent("", "form field complete", "component", "name_field", "field_completion", "", "ccaas-btn", "body").trigger();
                        }
                    });
                    //Account field completed
                    const accountNumber = document.querySelector(ccaasAccount);
                    if (accountNumber == null) return;
                    this.scope = accountNumber;
                    $(accountNumber).off("focusout").on("focusout", function () {
                        if (accountNumber.value.length > 0) {
                            new CcaaSEvent("", "form field complete", "component", "account_number", "field_completion", "", "ccaas-btn", "body").trigger();
                        }
                    });
                    //Subject field completed
                    const subject = document.querySelector(ccaasSubject);
                    if (subject == null) return;
                    this.scope = subject;
                    $(subject).off("focusout").on("focusout", function () {
                        if (subject.value.length > 0) {
                            new CcaaSEvent("", "form field complete", "component", "subject", "field_completion", "", "ccaas-btn", "").trigger();
                        }
                    });
                    //Email field completed
                    const email = document.querySelector(ccaasEmail);
                    if (email == null) return;
                    this.scope = email;
                    $(email).off("focusout").on("focusout", function () {
                        if (email.value.length > 0) {
                            new CcaaSEvent("", "form field complete", "component", "email", "field_completion", "", "ccaas-btn", "").trigger();
                        }
                    });
                    //Cancel button
                    const cancel = document.querySelector(ccaasCancel);
                    if (cancel == null) return;
                    this.scope = cancel;
                    $(cancel).on("click", function () {
                        new CcaaSEvent("", "chat_cancel", "component", "initiate", "button_click", "", "ccaas-cancel-btn", "").trigger();
                        //return the focus to the ccaas button after closing the chat
                        const ccaasBtnDiv = document.querySelector(ccassButtonDiv);
                        if (ccaasBtnDiv == null) return;
                        ccaasBtnDiv.focus();
                    });
                    //Minimize/Maximize button
                    const minimize = document.querySelector(ccaasMinimize);
                    if (minimize) {
                        this.scope = minimize;
                        $(minimize).on("click", function () {
                            if ($(minimize).attr("class") === "cx-icon cx-button-minimize") {
                                new CcaaSEvent("", "chat_window_minimize", "component", "initiate", "button_click", "", "ccaas-window-minimize", "").trigger();
                            } else {
                                new CcaaSEvent("", "chat_window_maximize", "component", "initiate", "button_click", "", "ccaas-window-maximize", "").trigger();
                            }
                        });
                    }
                }

                //Close button
                const close = document.querySelector(ccaasClose);
                if (close == null) return;
                this.scope = close;

                $(close).off("click").on("click", function () {
                    new CcaaSEvent("", "chat_window_close_X", "component", "initiate", "X_button_click", "", "ccaas-window-X-button", "").trigger();

                    WaitForElement(".cx-end-confirm", function () {
                        new CcaasTracking("live_chat_attempt_to_close").trigger();
                        OnCcaasEndChatClick();
                        //Confirm End button
                        const confirmEndBtn = $(".cx-end-confirm");

                        $(confirmEndBtn).off("click").on("click", function () {
                            new CcaasTracking("live_chat_ended_by_client").trigger();
                            WaitForElement(".cx-toast.cx-close ", function () {
                                new CcaasTracking("live_chat_transcript_offered").trigger();
                                var yesBtn = $(".cx-toast.cx-close .cx-buttons-binary .cx-btn-primary");
                                var noBtn = $(".cx-toast.cx-close .cx-buttons-binary .cx-btn-default");

                                $(yesBtn).off("click").on("click", function () {
                                    new CcaasTracking("live_chat_transcript_accepted").trigger();
                                });
                                $(noBtn).off("click").on("click", function () {
                                    new CcaasTracking("live_chat_transcript_rejected").trigger();
                                });
                            }, 3000);
                        });
                    }, 3000);

                    //Multi-channel - Transcript
                    WaitForElement("#cx-chat-save-conversation", function () {
                        new CcaasTracking("live_chat_transcript_offered").trigger();

                        $("#cx-chat-save-conversation").on("click", function () {
                            new CcaasTracking("live_chat_transcript_accepted").trigger();
                        });
                    }, 3000);
                });
            }, observerTimeoutValue);
        }
        function OnStartChatButtonClick() {
            setTimeout(function () {
                if ($(messageInputSelector) && $(messageInputSelector).is(":visible"))
                    new CcaaSEvent("", "start_chat_click", "component", "initiate", "button_click", "", "ccaas-chat-btn", "").trigger();
            }, defaultTimeoutValue);
        }
        function OnCcaasEndChatClick() {
            new CcaasAltEvent("chat_dismissed", "component", "visible", "chat_dismissed", "chat-modal", GetProductName(), "End_chat_button", "lower body", "0").trigger();
        }
        function OnCccasSendButtonClick() {
            new CcaasAltEvent("chat_sent", "component", "visible", "chat_sent", "chat-modal", GetProductName(), "chat_send_button", "lower body", "0").trigger();
        }

        //CCAAS ALT Events (FR)
        //Chat events
        eventManager.subscribe("OnCcaasAltModalSendChatClick", function () {
            WaitForElement(ccaasAltModalFormSendChatSelector, function () {
                if ($(ccaasAltModalFormSendChatSelector).is(":visible")) {
                    const nameOfModal = GetNameOfModal(ccaasAltModalFormSendChatSelector);
                    //Minimize modal callback
                    if ($(ccaasAltMinimizeIconSelector).is(":visible")) {
                        $(ccaasAltMinimizeIconSelector).off("click").on("click",
                            function () {
                                OnCcaasAltModalMinimizeClick("chat_en_direct", nameOfModal);
                            });
                    }
                    //Close modal send message
                    if ($(ccaasAltCloseIconSelector).is(":visible")) {
                        $(ccaasAltCloseIconSelector).off("click").on("click",
                            function () {
                                OnCcaasAltModalCloseClick("chat_en_direct", nameOfModal);
                            });
                    }
                }
            }, observerTimeoutValue);
        });
        //Message events
        eventManager.subscribe("OnCcaasAltModalSendMessageClick",
            function () {
                WaitForElement(ccaasAltModalFormSendMessageSelector,
                    function () {
                        if ($(ccaasAltModalFormSendMessageSelector).is(":visible")) {
                            const nameOfModal = GetNameOfModal(ccaasAltModalFormSendMessageSelector);
                            //Minimize modal callback
                            if ($(ccaasAltMinimizeIconSelector).is(":visible")) {
                                $(ccaasAltMinimizeIconSelector).off("click").on("click",
                                    function () {
                                        OnCcaasAltModalMinimizeClick("envoyer_un_message", nameOfModal);
                                    });
                            }
                            //Close modal send message
                            if ($(ccaasAltCloseIconSelector).is(":visible")) {
                                $(ccaasAltCloseIconSelector).off("click").on("click",
                                    function () {
                                        OnCcaasAltModalCloseClick("envoyer_un_message", nameOfModal);
                                    });
                            }
                            //Email field completed
                            OnCcaasAltModalFieldCompleteFocusout("envoyer_un_message", ccaasAltModalFormEmailSelector, nameOfModal);
                            //Firstname field completed
                            OnCcaasAltModalFieldCompleteFocusout("envoyer_un_message", ccaasAltModalFormFirstnameSelector,
                                nameOfModal);
                            //Question field completed
                            OnCcaasAltModalFieldCompleteFocusout("envoyer_un_message", ccaasAltModalFormQuestionSelector,
                                nameOfModal);
                            //form send button
                            if ($(ccaasAltModalFormSendButtonSelector).is(":visible")) {
                                WaitForElement(ccaasAltModalFormSendSuccessTextSelector,
                                    function () {
                                        new CcaasTracking("live_chat_contact_form_submitted").trigger();
                                        OnCcaasAltModalSendFormSubmitClick(nameOfModal);
                                    }, 10 * observerTimeoutValue);
                            }
                        }
                    },
                    observerTimeoutValue);
            });
        //callback events
        eventManager.subscribe("OnCcaasAltModalCallbackClick",
            function () {
                WaitForElement(ccaasAltModalCallBackSelector,
                    function () {
                        if ($(ccaasAltModalCallBackSelector).is(":visible")) {
                            var nameOfModal = GetNameOfModal(ccaasAltModalCallBackSelector);
                            //Minimize modal callback
                            if ($(ccaasAltMinimizeIconSelector).is(":visible")) {
                                $(ccaasAltMinimizeIconSelector).off("click").on("click",
                                    function () {
                                        OnCcaasAltModalMinimizeClick("recevoir_un_appel", nameOfModal);
                                    });
                            }
                            //Close modal callback
                            if ($(ccaasAltCloseIconSelector).is(":visible")) {
                                $(ccaasAltCloseIconSelector).off("click").on("click",
                                    function () {
                                        OnCcaasAltModalCloseClick("recevoir_un_appel", nameOfModal);
                                    });
                            }
                            //Phone Number field completed
                            OnCcaasAltModalFieldCompleteFocusout("recevoir_un_appel", ccaasAltModalCallBackPhoneNumberSelector,
                                nameOfModal);
                            //Schedule desired time selection
                            if ($(ccaasAltModalCallBackDesiredTimeSelector).is(":visible")) {
                                $(ccaasAltModalCallBackDesiredTimeSelector).on("click", function () {
                                    new CcaasAltEvent("button_click", "component", "recevoir_un_appel", "time_selection", nameOfModal, $(this).text(), $(ccaasAltModalCallBackDesiredTimeSelector).attr("id"), "body", "0").trigger();
                                });
                            }
                            //form cancel button
                            if ($(ccaasAltModalCallBackCancelButtonSelector).is(":visible")) {
                                $(ccaasAltModalCallBackCancelButtonSelector).off("click").on("click",
                                    function () {
                                        OnCcaasAltModalCallBackCancelClick(nameOfModal);
                                    });
                            }
                            //form confirm button
                            if ($(ccaasAltModalCallBackConfirmButtonSelector).is(":visible")) {
                                $(ccaasAltModalCallBackConfirmButtonSelector).off("click").on("click",
                                    function () {
                                        OnCcaasAltModalCallBackConfirmClick(nameOfModal);
                                    });
                            }
                        }
                    },
                    observerTimeoutValue);
            });

        //Generic Helper Functions
        function OnCcaasAltModalMinimizeClick(panel, nameOfModal) {
            //Close callback trigger
            new CcaasAltEvent("minimize_click", "component", panel, "panel_minimized", nameOfModal, "", "minimize_button", "body", "0").trigger();
        }
        function OnCcaasAltModalCloseClick(panel, nameOfModal) {
            //Close callback trigger
            new CcaasAltEvent("close_click", "component", panel, "panel_closed", nameOfModal, "", "close_button", "body", "0").trigger();
        }
        function OnCcaasAltModalFieldCompleteFocusout(panel, fieldSelector, nameOfModal) {
            if (IsNullOrWhiteSpace(fieldSelector)) return;
            const field = $(fieldSelector);
            if (field.length) {
                if (field.is(":visible")) {
                    field.off("focusout").on("focusout",
                        function () {
                            if (field.val().length > 0) {
                                new CcaasAltEvent(field.attr("name") + "_field_enter", "component", panel, "field_complete", nameOfModal, "", field.attr("id"), "body", "0").trigger();
                            }
                        });
                }
            }
        }

        //Message specific helper functions
        function OnCcaasAltModalSendFormSubmitClick(nameOfModal) {
            //Form submit trigger

            new CcaasAltEvent("submit_click", "component", "envoyer_un_message", "submit_click", nameOfModal, "", "submit_button", "body", "0").trigger();
            //modal Send Message Success
            if ($(ccaasAltCloseIconSelector).is(":visible")) {
                $(ccaasAltCloseIconSelector).off("click").on("click", function () {
                    //Close modal trigger
                    new CcaasAltEvent("close_click", "component", "envoyer_un_message", "confirmation_panel_closed", GetNameOfModal(ccaasAltModalFormSendSuccess), "", "close_button", "body", "0").trigger();
                });
            }
        }
        //Callback specific helper functions
        function OnCcaasAltModalCallBackCancelClick(nameOfModal) {
            //Cancel callback trigger
            new CcaasTracking("live_chat_callback_form_rejected").trigger();
            new CcaasAltEvent("cancel_click", "component", "recevoir_un_appel", "phone_cancel", nameOfModal, "", "cancel_button", "body", "0").trigger();
        }
        function OnCcaasAltModalCallBackConfirmClick(nameOfModal) {
            //Confirm callback trigger
            new CcaasTracking("live_chat_callback_form_submitted").trigger();
            new CcaasAltEvent("confirmer_click", "component", "recevoir_un_appel", "submit_click", nameOfModal, "", "confirmer_button", "body", "0").trigger();
        }

        //proactive engagement events
        var predictiveEngagementIteration = 0;
        function WaitForPredictiveEgagement() {
            if (typeof window.ac !== "undefined") {
                console.log("Found predictive engagement");
                //variable exists, do what you want
                ac('on', 'webchat:offered', function (event) {
                    new CcaasTracking("live_chat_toaster_displayed").trigger();
                    new CcaasAltEvent("chat_served", "component", "visible", "chat_modal_visible", "chat-modal", GetProductName(), "ccaas-modal", "lower body", "0", GetEventActionDisplayName(event)).trigger();
                });

                ac('on', 'webchat:rejected', function (event) {
                    new CcaasTracking("live_chat_toaster_rejected").trigger();
                    new CcaasAltEvent("button_click", "component", "initiate", "No_thanks_click", "chat-modal", GetProductName(), "No_thanks_buttons", "lower body", "0", GetEventActionDisplayName(event)).trigger();
                });

                ac('on', 'webchat:accepted', function (event) {
                    new CcaasAltEvent("button_click", "component", "initiate", "Chat_with_us_click", "chat-modal", GetProductName(), "Chat_with_us_button", "lower body", "0", GetEventActionDisplayName(event)).trigger();
                });

                ac('on', 'webchat:started', function (event) {
                    new CcaasAltEvent("chat_served", "component", "visible", "Live_chat_console_start", "chat-modal", GetProductName(), "Live_chat_console", "lower body", "0", GetEventActionDisplayName(event)).trigger();

                    //Attach to send btn in new iFrame
                    WaitForElement(".cx-send", function () {
                        //Send message button
                        const sendMsgBtn = $(".cx-send");
                        if (sendMsgBtn == null) return;
                        sendMsgBtn.unbind("click").on("click", OnCccasSendButtonClick);
                    }, observerTimeoutValue);

                    //Attach to close button in new iFrame
                    const close = document.querySelector(ccaasClose);
                    if (close == null) return;
                    this.scope = close;
                    $(close).on("click", function () {
                        new CcaaSEvent("", "chat_window_close_X", "component", "initiate", "X_button_click", GetProductName(), "ccaas-window-X-button", "").trigger();

                        //Attach to confirm button in new iFrame
                        WaitForElement(".cx-end-confirm ", function () {
                            const confirmEndBtn = $(".cx-end-confirm");
                            if (confirmEndBtn == null) return;
                            confirmEndBtn.unbind("click").on("click", OnCcaasEndChatClick);
                        }, observerTimeoutValue);
                    });
                });
            }
            else {
                predictiveEngagementIteration++;
                if (predictiveEngagementIteration <= 20) {
                    setTimeout(WaitForPredictiveEgagement, (predictiveEngagementIteration * 50));
                }
            }
        }

        //UTIL
        function GetEventActionDisplayName(event) {
            if (event) {
                return event.actionMapDisplayName;
            }
        }
        function WaitForElement(selector, callback, maxTime) {
            var startTime = Date.now();
            var interval = setInterval(function () {
                if ($(selector).is(":visible")) {
                    clearInterval(interval);
                    callback();
                } else {
                    if (Date.now() - startTime > maxTime) {
                        clearInterval(interval);
                    }
                }
            },
                100
            );
        }
        function IsNullOrWhiteSpace(text) {
            return text == null || text.match(/^ *$/) != null;
        }
        function SpaceReplace(text) {
            if (!IsNullOrWhiteSpace(text)) {
                const refinedText = text.trim().replace(/ /g, "_");
                return ReplaceAccents(refinedText);
            }
            return text;
        }
        function ReplaceAccents(text) {
            if (!IsNullOrWhiteSpace(text)) {
                const accent = [
                    /[\xc0-\xc6]/g, /[\xe0-\xe6]/g, // A, a
                    /[\xc7]/g, /[\xe7]/g, // C, c
                    /[\xc8-\xcb]/g, /[\xe8-\xeb]/g, // E, e
                    /[\xcc-\xcf]/g, /[\xec-\xef]/g, // I, i
                    /[\xd1]/g, /[\xf1]/g, // N, n
                    /[\xd2-\xd8]/g, /[\xf2-\xf8]/g, // O, o
                    /[\xd9-\xdc]/g, /[\xf9-\xfc]/g // U, u
                ];
                const noaccent = ["A", "a", "C", "c", "E", "e", "I", "i", "N", "n", "O", "o", "U", "u"];
                for (let i = 0; i < accent.length; i++) {
                    text = text.replace(accent[i], noaccent[i]);
                }
            }
            return text;
        }
        function GetNameOfModal(modalSelector) {
            if (IsNullOrWhiteSpace(modalSelector))
                return "";
            const modal = $(modalSelector);
            return (modal == null) ? "" : SpaceReplace(modal.attr("aria-label"));
        }
        function GetProductName() {
            if (window.utag.data.product_name) {
                return window.utag.data.product_name.join(", ");
            } else {
                return "";
            }
        }

        return CcaasChatTracker;
    });

define('SageDotCom/DataLayer/Events/product-list-button',[
    "jquery",
    "SageDotCom/DataLayer/Events/eventBase"
], function ($, EventBase) {
    
    function ProductListButton(el, eventName) {
        EventBase.call(el);

        var sectionTitleHeader = $(el).parents(".container").prev(".container").first().find(".score-section-header h2")
            .text().trim();
        var sectionTitleContentSpot = $(el).parents(".container").prev(".container").first().find(".score-content-spot h1").text().trim();
        var sectionTitle = sectionTitleHeader ? sectionTitleHeader : sectionTitleContentSpot;
        var titleCard = $(el).parents(".score-highlight").find(".score-highlight-header").text().trim();
        var cardName = $(el).parents(".caption").find(".inner-heading").text().trim();
        var flexItemPosition = $(el).closest(".score-flex-box").children().index($(el).parents(".flex-item"));

        this.props = {
            "event_name" : eventName,
            "shop_list_name": sectionTitle, 
            "product_group_name": [titleCard], 
            "product_group_id": [cardName],
            "product_list_position": [flexItemPosition+1],
            "product_category": ["subscription"],
            "product_sub_category_l1": [],
            "product_sub_category_l2": []
        };
    }
        ProductListButton.prototype = Object.create(EventBase.prototype);

        return ProductListButton;
});
define('SageDotCom/DataLayer/Global/product-list-tracker',[
        "jquery",
        "SageDotCom/DataLayer/Events/product-list-button"
    ],
    function ($, ProductListButton) {
        function ProductListTracker() {
            this.scope = $(".product-landing");
            this.button = $(".score-flex-box .flex-item .score-highlight .caption .score-call-to-action .score-button:visible", this.scope);
        }

        ProductListTracker.prototype.start = function () {
            if (!this.button) return;

            this.button.on("click", onClickEvent);

            var productImpressionArray = $(".score-flex-box .flex-item .score-highlight .caption .score-call-to-action .score-button:visible", this.scope);
            if (productImpressionArray.length > 0) {
                $(window).bind("load scroll", function () {
                    for (let i = productImpressionArray.length - 1; i >= 0; i--) {
                        if (isScrolledIntoView(productImpressionArray[i])) {
                            onScrollEvent(productImpressionArray[i]);
                            productImpressionArray.splice(i, 1);
                        }
                    }
                });
            }
        }

        function isScrolledIntoView(elem) {
            var docViewTop = $(window).scrollTop();
            var docViewBottom = docViewTop + $(window).height();

            var elemTop = $(elem).offset().top;
            var elemBottom = elemTop + $(elem).height();
            return ((elemBottom <= docViewBottom) && (elemTop >= docViewTop));
        }

        function onScrollEvent(e) {
            var eventName = "product_impression";
            new ProductListButton(e, eventName).trigger();
        }

        function onClickEvent(e) {
            var eventName = "product_click";
            new ProductListButton(e.currentTarget, eventName).trigger();
        }

        return ProductListTracker;
    });
define('SageDotCom/DataLayer/global',['jquery',
    'SageDotCom/DataLayer/Global/buttons',
    'SageDotCom/DataLayer/Global/tabsets',
    'SageDotCom/DataLayer/Global/scrolling',
    'SageDotCom/DataLayer/Global/imageButtons',
    'SageDotCom/DataLayer/Global/accordions',
    'SageDotCom/DataLayer/Global/search',
    'SageDotCom/DataLayer/Global/footer',
    'SageDotCom/DataLayer/Global/links',
    'SageDotCom/DataLayer/Global/header-menu-tracker',
    'SageDotCom/DataLayer/Global/carousel',
    'SageDotCom/DataLayer/Global/slider',
    'SageDotCom/DataLayer/Global/pageVisuals',
    'SageDotCom/DataLayer/Global/sticky-nav-tracker',
    'SageDotCom/DataLayer/Global/forms',
    'SageDotCom/DataLayer/Global/feedback',
    'SageDotCom/DataLayer/Global/iAdvizeCallBack',
    'SageDotCom/DataLayer/Global/generic-video-tracker',
    'SageDotCom/DataLayer/Global/brightcove-video-tracker',
    'SageDotCom/DataLayer/Global/ccaas-chat-tracker',
    'SageDotCom/DataLayer/Global/product-list-tracker'
],
    function (
        $,
        buttons,
        tabs,
        scrolling,
        imageButtons,
        accordions,
        search,
        footer,
        links,
        HeaderMenuTracker,
        carousel,
        slider,
        pageVisuals,
        StickyNavTracker,
        forms,
        FeedbackTracker,
        iAdvizeCallBackTracker,
        GenericVideoTracker,
        BrightcoveVideoTracker,
        CcaasChatTracker,
        ProductListTracker
    ) {

        function globalLoader() { }
        function initialize() {
            if (!window.BrainJocks.EE) {
                // initialize each tracking type into it's own event on the internal JS event queue
                // to prevent pages from 'hanging' as the tracking is being applied to elements
                setTimeout(tabs.initialize.bind(tabs), 0);
                setTimeout(buttons.initialize.bind(buttons), 0);
                setTimeout(scrolling.initialize.bind(scrolling), 0);
                setTimeout(imageButtons.initialize.bind(imageButtons), 0);
                setTimeout(accordions.initialize.bind(accordions), 0);
                setTimeout(search.initialize.bind(search), 0);
                setTimeout(footer.initialize.bind(footer), 0);
                setTimeout(links.initialize.bind(links), 0);
                setTimeout(HeaderMenuTracker.prototype.start.bind(new HeaderMenuTracker()), 0);
                setTimeout(carousel.initialize.bind(carousel), 0);
                setTimeout(slider.initialize.bind(slider), 0);
                setTimeout(pageVisuals.initialize.bind(pageVisuals), 0);
                setTimeout(StickyNavTracker.prototype.start.bind(new StickyNavTracker()), 0);
                setTimeout(forms.initialize.bind(forms), 0);
                setTimeout(FeedbackTracker.prototype.start.bind(new FeedbackTracker()), 0);
                setTimeout(iAdvizeCallBackTracker.prototype.start.bind(new iAdvizeCallBackTracker()), 0);
                setTimeout(new GenericVideoTracker().start, 0);
                setTimeout(new BrightcoveVideoTracker().start, 0);
                setTimeout(CcaasChatTracker.prototype.start.bind(new CcaasChatTracker()), 0);
                setTimeout(ProductListTracker.prototype.start.bind(new ProductListTracker()), 0);
            }
        };
        document.addEventListener("spaPageChanged", function () {            
            initialize();
        });

        globalLoader.prototype.initialize = initialize;

        return new globalLoader();
    });
