define('SageDotCom/DataLayer/Global/buttons',[
    'jquery',
    'SageDotCom/DataLayer/tealium',
    'SageDotCom/DataLayer/Events/exitLinkClick',
    'SageDotCom/DataLayer/Events/buttonClick',
    'SageDotCom/DataLayer/Events/internalLinkClick',
    'SageDotCom/DataLayer/Events/fileDownload',
    'SageDotCom/DataLayer/Util/urlHelper',
    'SageDotCom/DataLayer/Events/loginStart',
    'SageDotCom/DataLayer/Events/ctaClick',
    'SageDotCom/DataLayer/Events/skinnyBannerClick'
],
    function ($, analytics, exitLinkEvent, buttonClickEvent, internalLinkClickEvent, fileDownloadEvent, urlHelper, loginStartEvent, ctaClick, skinnyBannerClick) {
        function globalButtonTracking() { }

        globalButtonTracking.prototype.initialize = function initialize() {
            //Cta click event:
            $("a.cta_click, button.cta_click").on("click",
                function (event) {
                    var data = ctaClick.GenerateEventMetadata(event.currentTarget);
                    analytics.event(data);
                });

            $(".cta_click > a, .cta_click > button").on("click",
                function (event) {
                    var data = ctaClick.GenerateEventMetadata(event.currentTarget.parentElement);
                    analytics.event(data);
                });

            $(".score-button:not([data-xpr-state], [data-tracking]), .login-trigger, .btn:not([data-xpr-state], [data-tracking]), .sage-video-component:not([data-xpr-state], [data-tracking]), button.bank-feed-load-more")
                .not("footer .score-button, .sticky-navigation a, .select-anchor, .free-trial-form :submit, header .score-button, .customer-success-filter-button.prevent-tracking")
                .each(function (key, value) {
                    if (value.classList.contains("login-trigger")) {
                        value.addEventListener('click',
                            function (event) {
                                var data = loginStartEvent.GenerateEventMetadata(event.currentTarget);
                                analytics.event(data);
                            });
                        value.setAttribute('data-tracking', loginStartEvent.getName());
                    }
                    // internal URL if hostname is blank or matches current browser URL
                    else if (!value.hostname || !value.hostname.length || location.hostname.toLowerCase() === value.hostname.toLowerCase()) {
                        // handle file download vs internal link click
                        var fileTester = urlHelper.isFile(value.href);
                        if (fileTester.isFile === true && fileTester.fileName) {
                            value.addEventListener('click', function (event) {
                                var data = fileDownloadEvent.GenerateEventMetadata(event.currentTarget, fileTester.fileName);
                                analytics.event(data);
                            });

                            value.setAttribute('data-tracking', fileDownloadEvent.getName());
                        }
                        // check if this is score ccf button
                        else if (!value.href) {
                            value.addEventListener('click',
                                function (event) {
                                    if (event.currentTarget.classList.contains("sage-video-component")) {
                                        var data = internalLinkClickEvent.GenerateEventMetadata(event.currentTarget);
                                        data.event_label = "video overlay";
                                        data.event_name_level_2 = "video overlay";
                                        analytics.event(data);
                                    } else {
                                        var data = buttonClickEvent.GenerateEventMetadata(event.currentTarget);
                                        analytics.event(data);
                                    }
                                });
                            value.setAttribute('data-tracking', buttonClickEvent.getName());
                        } // otherwise this is internal link
                        else {
                            value.addEventListener('click',
                                function (event) {
                                    if (event.currentTarget.classList.contains("clickable-area-button") || event.currentTarget.classList.contains("lInk-button")) {
                                        var data = internalLinkClickEvent.GenerateEventMetadata(event.currentTarget);
                                        analytics.event(data);
                                        value.setAttribute('data-tracking', internalLinkClickEvent.getName());
                                    }
                                    else {
                                        var data = buttonClickEvent.GenerateEventMetadata(event.currentTarget);
                                        analytics.event(data);
                                        value.setAttribute('data-tracking', buttonClickEvent.getName());
                                    }
                                });
                        }
                    } // external URLv
                    else {
                        value.addEventListener('click',
                            function (event) {
                                var data = exitLinkEvent.GenerateEventMetadata(event.currentTarget);
                                analytics.event(data);
                            });
                        value.setAttribute('data-tracking', exitLinkEvent.getName());
                    }
                });

            $(".skinny-banner .integrated-countdown-timer").on("click", function (event) {
                var data = skinnyBannerClick.GenerateEventMetadata(event.currentTarget);
                analytics.event(data);
            });
        }

        return new globalButtonTracking();
    });
define('SageDotCom/DataLayer/Events/bodySelect',["jquery", "SageDotCom/DataLayer/Events/eventBase"], function ($, EventBase) {

    function BodySelectEvent() {
        EventBase.call(this); // inherit eventBase
        this.name = "body_selection"; // overwrite name
    }

    BodySelectEvent.prototype = Object.create(EventBase.prototype);

    BodySelectEvent.prototype.GenerateEventMetadata = function GenerateEventMetadata(scope, label, name, category, level2, level1, elementTag = "a") {
        var eventName = name || this.getName();
        var eventCategory = category || "component";
        var eventLevel2 = "";
        if (level2 !== "") eventLevel2 = this.getId(scope);
        var eventData = {
            'event_name': eventName,
            'event_non-int': "0",
            'event_category': eventCategory,
            'event_action': this.getName()
        }

        if (scope) {
            var lbl = label || $(scope).attr("data-title") || $(scope).text() || $("a:first", scope).text() || $("button:first", scope).text() || "";
            var location = this.getLocation(scope);
            var id = $(scope).attr("id") || $(scope).attr("href") || "";

            var eventLevel1 = (id !== "") ? elementTag + '[href^="#' + id.replace("#", "") + '"]' : "";
            if (level1 === "id") {
                eventLevel1 = id;
            }
            eventData = $.extend(eventData, {
                'event_label': this.stripHtml(lbl.trim()), // strip any html
                'event_name_level_1': eventLevel1,
                'event_name_level_2': eventLevel2,
                'event_name_level_3': "",
                'event_name_level_4': location
            });
        }

        return eventData;
    }

    return new BodySelectEvent();
});
define('SageDotCom/DataLayer/Global/tabsets',['jquery',
        'SageDotCom/DataLayer/tealium',
        'SageDotCom/DataLayer/Events/bodySelect'],
    function ($, tealium, bodySelect) {
        function globalTabsetTracking() { }

        globalTabsetTracking.prototype.initialize = function initialize() {
            $(".score-tab-panel:not([data-xpr-state], [data-tracking]), .score-accordion-panel").each(function (key, panel) {
                var id = $(panel).attr('id');
                $('.nav-tab-btn[href^="#' + id + '"], a[href^="#' + id + '"]').click(function (event) {
                    // button has a aria-expanded attribute set to either 'true' or 'false
                    // check it's value before raising the event to prevent it from being
                    // raised needlessly once the panel is already opened.  for whatever
                    // reason, this attribute is undefined if the panel hasn't been activated
                    var expanded = $(event.currentTarget).attr('aria-expanded');
                    var selected = $(event.currentTarget).attr('aria-selected');
                    //If undefined, assume false
                    var isExpanded = typeof expanded == 'undefined' ? "false" : expanded;
                    var isSelected = typeof selected == 'undefined' ? "false" : selected;
                    if (isExpanded === "false" && isSelected === "false") {
                        var data = bodySelect.GenerateEventMetadata(panel, undefined, undefined, undefined, undefined, undefined, this.tagName.toLowerCase());
                        tealium.event(data);
                    }
                });
                $(panel).attr('data-tracking', bodySelect.getName());
            });
            
            $(".tabAccordion-accordion .tabAccordion-panel-accordion .panel-heading .nav-tab-btn, .tabAccordion-accordion .tabAccordion-panel-accordion .panel-heading a").each(function (key, panel) {
                var id = $(panel).attr('href');
                $('.nav-tab-btn[href^="' + id + '"], a[href^="' + id + '"]').click(function (event) {
                    // button has a aria-expanded attribute set to either 'true' or 'false
                    // check it's value before raising the event to prevent it from being
                    // raised needlessly once the panel is already opened.  for whatever
                    // reason, this attribute is undefined if the panel hasn't been activated
                    var expanded = $(event.currentTarget).attr('aria-expanded');
                    if (typeof expanded == 'undefined' || expanded === 'false') {
                        var data = bodySelect.GenerateEventMetadata(panel, undefined, undefined, undefined, undefined, undefined, this.tagName.toLowerCase());
                        tealium.event(data);
                    }
                });
                $(panel).attr('data-tracking', bodySelect.getName());
            });

        }

        return new globalTabsetTracking();
    });
define('SageDotCom/DataLayer/Util/scrollHelper',['jquery'], function ($) {

    function scrollHelper() { }

