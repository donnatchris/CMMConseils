                    $(field).on("blur", function (event) {
                        var $field = $(event.currentTarget);
                        var oldValue = $field.data("oldValue");
                        var inputValue = $field.val();

                        if ((oldValue !== inputValue) && inputValue.length > 0) {
                            var fieldCompletionData = fieldCompletion.GenerateEventMetadata($field);
                            analytics.event(fieldCompletionData);
                        }
                        if (!$(field).valid() || $(field).hasClass("is-invalid")) {
                            var fieldCompletionErrorData = fieldCompletionError.GenerateEventMetadata($field);
                            analytics.event(fieldCompletionErrorData);
                        }
                    });
                });
                $(form).find('select').each(function (selectIndex, select) {
                    $(select).focus(function () {
                        captureFormStart(form, select);
                    });

                    componentRegistrations.push({ obj: select, name: fieldCompletion.getName() });

                    $(select).change(function (event) {
                        var data = fieldCompletion.GenerateEventMetadata($(event.currentTarget));
