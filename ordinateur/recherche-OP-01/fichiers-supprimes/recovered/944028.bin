define('SageDotCom/DataLayer/Util/htmlHelper',['jquery'], function ($) {

    function htmlHelper() { }

    // find the most prominent text within a chunk of HTML
    htmlHelper.prototype.findTitle = function findTitle(html) {
        var defaultLabel = '(not set)';

        var h1 = $("h1", html).first().text();
        var h2 = $("h2", html).first().text();
        var h3 = $("h3", html).first().text();
        var p = $("p", html).first().text();

        return h1 || h2 || h3 || p || defaultLabel;
    }

    return new htmlHelper();
});
define('SageDotCom/DataLayer/Util/jQueryExtensions',['jquery', "jqueryValidate", "jqueryValidateUnobtrusive"], function($) {
    $.fn.nextOrFirst = function (selector) {
        var next = this.next(selector);
        return (next.length) ? next : this.prevAll(selector).last();
    };

    $.fn.prevOrLast = function (selector) {
        var prev = this.prev(selector);
        return (prev.length) ? prev : this.nextAll(selector).last();
    };

    $.validator.unobtrusive.adapters.add('ischecked', ['valuetocompare'], function (options) {
        options.rules['ischecked'] = options.params;
        if (options.message != null) {
            options.messages['ischecked'] = options.message;
        }
    });

    $.validator.addMethod('ischecked', function (value, element, params) {
        if (typeof value === "undefined" || value == null) {
            return false;
        } else if ($(element).is(':checkbox')) {
            if ($(element).is(':checked')) {
                return true;
            } else {
                return false;
            }
        }
        return params.valuetocompare.toLowerCase() === value.toLowerCase();
    });

    $.validator.unobtrusive.adapters.add('requiredifothernotequals', ['elementtocompare', 'conditionalvalue'], function (options) {
        options.rules['requiredifothernotequals'] = options.params;
        if (options.message != null) {
            options.messages['requiredifothernotequals'] = options.message;
        }
    });

    $.validator.addMethod('requiredifothernotequals', function (value, element, params) {
        var valueFromElement = $('[name="' + params['elementtocompare'] + '"]').val();
        var valueToCompare = params['conditionalvalue'];

        if (valueFromElement.toLowerCase() !== valueToCompare.toLowerCase()) {
            if (typeof value === "undefined" || value == null || value === "") {
                return false;
            } else {
                return true;
            }
        }

        return true;
    });


    /**
     * File upload Content Type
     */
    $.validator.unobtrusive.adapters.addSingleVal("contenttype", "allowedcontenttypes");

    $.validator.addMethod("contenttype", function (value, element, allowedcontenttypes) {
        if (!this.optional(element)) {
            for (var i = 0; i < element.files.length; i++) {
                if (allowedcontenttypes.indexOf(element.files[i].type) < 0) {
                    return false;
                }
            }
        }
        return true;
    });

    /**
     * File upload File Size
     */
    $.validator.unobtrusive.adapters.addSingleVal("filesize", "maxfilesize");
    $.validator.addMethod("filesize", function (value, element, maxfilesize) {
        if (!this.optional(element)) {
            for (var i = 0; i < element.files.length; i++) {
                if (element.files[i].size > maxfilesize) {
                    return false;
                }
            }
        }
        return true;
    });

    // Date Time Span Validator

    $.validator.unobtrusive.adapters.add('timespan', ['min', 'max', 'unit'], function (options) {
        options.rules['timespan'] = [options.params.min, options.params.max, options.params.unit];
        options.messages['timespan'] = options.message;
    });

});
define('SageDotCom/DataLayer/Global/carousel',['jquery',
        'SageDotCom/DataLayer/tealium',
        'SageDotCom/DataLayer/Events/carouselCustomerStory',
        'SageDotCom/DataLayer/Events/carouselGeneric',
        'SageDotCom/DataLayer/Events/carouselHero',
        'SageDotCom/DataLayer/Util/trackingHelper',
        'SageDotCom/DataLayer/Util/htmlHelper',
        'SageDotCom/DataLayer/Util/jQueryExtensions'],
    function ($, tealium, customerStory, generic, hero, trackingHelper, htmlHelper) {
        function globalCarouselTracking() { }

        function deriveControl(e) {
            var control = 'select';

            if (e.currentTarget.className.indexOf('carousel-control') !== -1) {
                var direction = e.currentTarget.className.indexOf('right') !== -1 ? 'right' : 'left';
                control = direction;
            }

            return control;
        }

        function getEventType(carousel) {
            if ($(".hero--customer-quote", carousel).length > 0) {
                // customer success carousel
                return customerStory;
            } else if ($("h1, .score-hero", carousel).length > 0) {
                // hero carousel
                return hero;
            }

            // normal carousel
            return generic;
        }

        function deriveMenu(e, carousel) {
            var $paneId = '(not set)';
            var $current = $('.score-carousel-pic-pane.active', carousel);

            if ($(e.currentTarget).attr('data-slide-to')) {
                var index = $(e.currentTarget).attr('data-slide-to');

                if (!isNaN(index)) {
                    index = parseInt(index);
                    // carousel pane is identified by paneId

                    $paneId = $($(".score-carousel-pic-pane")[index]).attr('id');
                } else {
                    $paneId = index;
                }

            } else if (e.currentTarget.className.indexOf('left') !== -1) {
                // transitioning left
                $paneId = $current.prevOrLast('.score-carousel-pic-pane').attr('id');
            } else if (e.currentTarget.className.indexOf('right') !== -1) {
                // transitioning right
                $paneId = $current.nextOrFirst('.score-carousel-pic-pane').attr('id');
            }
            
            return $paneId;
        }

        globalCarouselTracking.prototype.initialize = function initialize() {
            $(".score-carousel:not([data-xpr-state], [data-tracking])").each(function (key, carousel) {
                var event = getEventType(carousel);
                $(".carousel-control, .carousel-indicators li", carousel).click(function (e) {
                    var control = deriveControl(e);
                    var menu = deriveMenu(e, carousel);
                    var obj = event.GenerateEventMetadata(carousel, control, menu);

                    tealium.event(obj);
                });
                trackingHelper.registerTracking(carousel, event.getName());
            });
        }

        return new globalCarouselTracking();
    });
define('SageDotCom/DataLayer/Global/slider',['jquery',
        'SageDotCom/DataLayer/tealium',
        'SageDotCom/DataLayer/Events/carouselCustomerStory',
        'SageDotCom/DataLayer/Events/carouselGeneric',
        'SageDotCom/DataLayer/Events/carouselHero',
        'SageDotCom/DataLayer/Util/trackingHelper',
        'SageDotCom/DataLayer/Util/htmlHelper',
        'slick'],
    function ($, tealium, customerStory, generic, hero, trackingHelper, htmlHelper) {
        function globalSliderTracking() { }

        function deriveControl(e) {
            var control = '(not set)';

            if (e.currentTarget.className.indexOf('carousel-control') !== -1) {
                var direction = e.currentTarget.className.indexOf('right') !== -1 ? 'right' : 'left';
                control = "Arrow: " + direction;
            } else {
                var slide = $(e.currentTarget).attr('data-slide-to');
                control = "Slide: " + slide;
            }

            return control;
        }

        function getEventType(carousel) {
            if ($(".hero--customer-quote", carousel).length > 0) {
                // customer success carousel
                return customerStory;
            } else if ($("h1, .score-hero", carousel).length > 0) {
                // hero carousel
                return hero;
            }

            // normal carousel
            return generic;
        }

        globalSliderTracking.prototype.initialize = function initialize() {
            $(".slick-slider:not([data-xpr-state], [data-tracking])").each(function(key, slider) {
                var event = getEventType(slider);

                $(slider).on('swipe', function (e, slick, direction) {
                    // invert the direction as we want to know the direction the user is swiping to, not the direction
                    // that the panes are moving in
                    var label = direction === "left" ? "right" : "left"; 

                    var currentSlide = $("[data-slick-index='" + slick.currentSlide + "']", slider);
                    var menu = htmlHelper.findTitle(currentSlide);

                    var eventObj = event.GenerateEventMetadata(slider, label, menu);
                    tealium.event(eventObj);
                });

                $(".slick-arrow", slider).on('click', function (e) {
                    // invert the direction as we want to know the direction the user is swiping to, not the direction
                    // that the panes are moving in
                    var label = $(e.currentTarget).hasClass('slick-next') ? "right" : "left";

                    var currentSlideIndex = $(slider).slick('slickCurrentSlide');
                    var currentSlide = $("[data-slick-index='" + currentSlideIndex + "']", slider);
                    var menu = htmlHelper.findTitle(currentSlide);
                
                    var eventObj = event.GenerateEventMetadata(slider, label, menu);
                    tealium.event(eventObj);
                });
                
                $(".slick-dots li", slider).on('click', function (e) {
                    var label = "select";

                    var currentSlideIndex = $(slider).slick('slickCurrentSlide');
                    var currentSlide = $("[data-slick-index='" + currentSlideIndex + "']", slider);
                    var menu = htmlHelper.findTitle(currentSlide);
                
                    var eventObj = event.GenerateEventMetadata(slider, label, menu);
                    tealium.event(eventObj);
                });

                trackingHelper.registerTracking(slider, event.getName());
            });
        }

        return new globalSliderTracking();
    });
define('SageDotCom/DataLayer/Global/pageVisuals',['jquery',
    'SageDotCom/DataLayer/tealium'],
    function ($, tealium) {
        function pageVisuals() { }

        // rip out the background image url from a background-image style on an element
        function getBackgroundImage(elem) {
            if (elem) {
                var style = $(elem).css('background-image');
                if (style) {
                    style = decodeURIComponent(style);

                    // if there's a background style on the element, then it will be like: url("http://..."), so we
                    // need to strip out the 'url("")' parts.
                    return style.slice(4, -1).replace(/"/g, '');
                }
            }
            return null;
        }


        function getHeroThumbnail() {
            var thumb = $(".score-hero-image:first img").attr('src');
            if (thumb)
                return decodeURIComponent(thumb);
            return null;
        }

        pageVisuals.prototype.initialize = function initialize() {
            var heroText = '(not set)';
            var heroImage = '(not set)';

            var $hero = $(".score-hero, .score-document-header, .score-document-header-with-subtitle, h1").first();

            if ($hero) {
                heroText = $("h1", $hero).text() || $("h2", $hero).text() || $hero.text();
                heroText = heroText.replace(/\n/g, ' '); // newline characters
                heroText = heroText.replace(/ +(?= )/g, ''); // remove multiple spaces
                heroText = heroText.trim();

                var $stripe = $hero.closest(".score-pic-stripe, .score-stripe").first();

