<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Package
    IgnorableNamespaces="build com desktop desktop4 desktop6 desktop9 mp rescap uap uap5 systemai"
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:build="http://schemas.microsoft.com/developer/appx/2015/build"
    xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
    xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
    xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
    xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
    xmlns:desktop9="http://schemas.microsoft.com/appx/manifest/desktop/windows10/9"
    xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    xmlns:rescap3="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities/3"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
    xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
    xmlns:systemai="http://schemas.microsoft.com/appx/manifest/systemai/windows10"
>
    <Identity
        Name="Microsoft.OutlookForWindows"
        ProcessorArchitecture="x64"
        Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US"
        Version="1.2026.818.100" />
    <!-- resources, driven by makepri details. -->
    <Resources>
        <Resource uap:Scale="100" />
        <Resource uap:Scale="125" />
        <Resource uap:Scale="150" />
        <Resource uap:Scale="200" />
        <Resource uap:Scale="400" />
        <Resource Language="en-us" />
        <Resource Language="af" />
        <Resource Language="am" />
        <Resource Language="ar" />
        <Resource Language="as-IN" />
        <Resource Language="az-Latn-AZ" />
        <Resource Language="bg" />
        <Resource Language="bn-IN" />
        <Resource Language="bs-Latn-BA" />
        <Resource Language="ca" />
        <Resource Language="ca-Es-VALENCIA" />
        <Resource Language="cs" />
        <Resource Language="cy" />
        <Resource Language="da" />
        <Resource Language="de" />
        <Resource Language="el" />
        <Resource Language="en" />
        <Resource Language="en-GB" />
        <Resource Language="es" />
        <Resource Language="es-MX" />
        <Resource Language="et" />
        <Resource Language="eu" />
        <Resource Language="fa" />
        <Resource Language="fi" />
        <Resource Language="fil" />
        <Resource Language="fr" />
        <Resource Language="fr-CA" />
        <Resource Language="ga-IE" />
        <Resource Language="gd-gb" />
        <Resource Language="gl" />
        <Resource Language="gu" />
        <Resource Language="he" />
        <Resource Language="hi" />
        <Resource Language="hr" />
        <Resource Language="hu" />
        <Resource Language="hy" />
        <Resource Language="id" />
        <Resource Language="is" />
        <Resource Language="it" />
        <Resource Language="ja" />
        <Resource Language="ka" />
        <Resource Language="kk" />
        <Resource Language="km-KH" />
        <Resource Language="kn" />
        <Resource Language="ko" />
        <Resource Language="kok" />
        <Resource Language="lb-LU" />
        <Resource Language="lo-LA" />
        <Resource Language="lt" />
        <Resource Language="lv" />
        <Resource Language="mi-NZ" />
        <Resource Language="mk" />
        <Resource Language="ml" />
        <Resource Language="mr" />
        <Resource Language="ms" />
        <Resource Language="mt-MT" />
        <Resource Language="ne-NP" />
        <Resource Language="nl" />
        <Resource Language="nn-NO" />
        <Resource Language="no" />
        <Resource Language="or" />
        <Resource Language="pa-IN" />
        <Resource Language="pl" />
        <Resource Language="pt" />
        <Resource Language="pt-PT" />
        <Resource Language="quz-PE" />
        <Resource Language="ro" />
        <Resource Language="ru" />
        <Resource Language="sk" />
        <Resource Language="sl" />
        <Resource Language="sq" />
        <Resource Language="sr-Cyrl" />
        <Resource Language="sr-Cyrl-BA" />
        <Resource Language="sv" />
        <Resource Language="ta" />
        <Resource Language="te" />
        <Resource Language="th" />
        <Resource Language="tr" />
        <Resource Language="ug-CN" />
        <Resource Language="uk" />
        <Resource Language="ur" />
        <Resource Language="vi" />
        <Resource Language="zh-Hans" />
        <Resource Language="zh-Hant" />
    </Resources>
    <Capabilities>
        <rescap:Capability Name="runFullTrust" />
        <rescap:Capability Name="unvirtualizedResources" />
        <rescap:Capability Name="packageManagement" />
        <rescap:Capability Name="internetClient" />
        <systemai:Capability Name="systemAIModels" />
    </Capabilities>
    <Properties>
        <PublisherDisplayName>Microsoft Corporation</PublisherDisplayName>
        <DisplayName>Outlook for Windows</DisplayName>
        <Logo>Assets\StoreLogo.png</Logo>
        <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
        <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
    </Properties>
    <Applications>
        <!-- Outlook Application Entrypoint -->
        <Application EntryPoint="Windows.FullTrustApplication" Executable="olk.exe"
            Id="Microsoft.OutlookforWindows">
            <uap:VisualElements
                AppListEntry="default"
                BackgroundColor="transparent"
                Description="Microsoft Outlook"
                DisplayName="Outlook"
                Square150x150Logo="Assets\MedTile.png"
                Square44x44Logo="Assets\AppList.png">
                <uap:InitialRotationPreference>
                    <uap:Rotation Preference="portrait" />
                    <uap:Rotation Preference="landscape" />
                </uap:InitialRotationPreference>
                <uap:DefaultTile
                    Square71x71Logo="Assets\SmallTile.png"
                    Wide310x150Logo="Assets\WideTile.png"
                    Square310x310Logo="Assets\LargeTile.png"
                />
            </uap:VisualElements>
            <Extensions>
                <desktop:Extension Category="windows.fullTrustProcess"
                    Executable="olkFullTrustExecutor.exe">
                </desktop:Extension>
                <uap5:Extension
                    Category="windows.appExecutionAlias"
                    EntryPoint="Windows.FullTrustApplication" Executable="olk.exe">
                    <uap5:AppExecutionAlias>
                        <uap5:ExecutionAlias Alias="olk.exe" />
                    </uap5:AppExecutionAlias>
                </uap5:Extension>
                <uap:Extension
                    Category="windows.protocol">
                    <uap:Protocol Name="ms-outlook" />
                </uap:Extension>
                <uap:Extension
                    Category="windows.protocol">
                    <uap:Protocol Name="mailto" />
                </uap:Extension>
                <uap:Extension
                    Category="windows.protocol">
                    <uap:Protocol Name="webcal" />
                </uap:Extension>
                <uap:Extension
                    Category="windows.protocol">
                    <uap:Protocol Name="webcals" />
                </uap:Extension>
                <uap:Extension
                    Category="windows.fileTypeAssociation">
                    <uap:FileTypeAssociation Name="ics" DesiredView="default">
                        <uap:SupportedFileTypes>
                            <uap:FileType>.ics</uap:FileType>
                        </uap:SupportedFileTypes>
                        <uap:DisplayName>iCalendar File</uap:DisplayName>
                        <uap:Logo>Assets/CalendarIcon.png</uap:Logo>
                    </uap:FileTypeAssociation>
                </uap:Extension>
                <uap:Extension
                    Category="windows.fileTypeAssociation">
                    <uap:FileTypeAssociation Name="msg" DesiredView="default">
                        <uap:SupportedFileTypes>
                            <uap:FileType>.msg</uap:FileType>
                        </uap:SupportedFileTypes>
                        <uap:DisplayName>Outlook Item</uap:DisplayName>
                        <uap:Logo>Assets/MailIcon.png</uap:Logo>
                    </uap:FileTypeAssociation>
                </uap:Extension>
                <uap:Extension
                    Category="windows.fileTypeAssociation">
                    <uap:FileTypeAssociation Name="eml" DesiredView="default">
                        <uap:SupportedFileTypes>
                            <uap:FileType>.eml</uap:FileType>
                        </uap:SupportedFileTypes>
                        <uap:DisplayName>E-mail Message</uap:DisplayName>
                        <uap:Logo>Assets/MailIcon.png</uap:Logo>
                    </uap:FileTypeAssociation>
                </uap:Extension>
                <uap:Extension
                    Category="windows.fileTypeAssociation">
                    <uap:FileTypeAssociation Name="oft" DesiredView="default">
                        <uap:SupportedFileTypes>
                            <uap:FileType>.oft</uap:FileType>
                        </uap:SupportedFileTypes>
                        <uap:DisplayName>Outlook File Template</uap:DisplayName>
                        <uap:Logo>Assets/MailIcon.png</uap:Logo>
                    </uap:FileTypeAssociation>
                </uap:Extension>
                <uap:Extension
                    Category="windows.fileTypeAssociation">
                    <uap:FileTypeAssociation Name="vcf" DesiredView="default">
                        <uap:SupportedFileTypes>
                            <uap:FileType>.vcf</uap:FileType>
                        </uap:SupportedFileTypes>
                        <uap:DisplayName>vCard File</uap:DisplayName>
						<uap:Logo>Assets/ContactCardIcon.png</uap:Logo>
                    </uap:FileTypeAssociation>
                </uap:Extension>
                <uap:Extension
                    Category="windows.shareTarget">
                    <uap:ShareTarget>
                        <uap:SupportedFileTypes>
                            <uap:SupportsAnyFileType />
                        </uap:SupportedFileTypes>
                        <uap:DataFormat>Text</uap:DataFormat>
                        <uap:DataFormat>Html</uap:DataFormat>
                    </uap:ShareTarget>
                </uap:Extension>
                <uap3:Extension
                    Category="windows.appUriHandler">
                    <uap3:AppUriHandler>
                        <uap3:Host Name="outlook.office.com" />
                        <uap3:Host Name="outlook.office365.com" />
                        <uap3:Host Name="outlook.cloud.microsoft" />
                    </uap3:AppUriHandler>
                </uap3:Extension>
                <rescap3:Extension
                    Category="windows.desktopAppMigration">
                    <rescap3:DesktopAppMigration>
                        <rescap3:DesktopApp
                            AumId="microsoft.windowscommunicationsapps_8wekyb3d8bbwe!microsoft.windowslive.mail" />
                    </rescap3:DesktopAppMigration>
                </rescap3:Extension>
                <com:Extension
                    Category="windows.comServer">
                    <com:ComServer>
                        <com:ExeServer Executable="olk.exe" Arguments="-ToastActivated"
                            DisplayName="NotificationActivator">
                            <com:Class Id="cf57ab46-9d90-5e9d-b5ec-b13a74e5b68f"
                                DisplayName="NotificationActivator" />
                        </com:ExeServer>
                    </com:ComServer>
                </com:Extension>
                <!--Specify
                which CLSID to activate when toast clicked-->
                <desktop:Extension
                    Category="windows.toastNotificationActivation">
                    <desktop:ToastNotificationActivation ToastActivatorCLSID="cf57ab46-9d90-5e9d-b5ec-b13a74e5b68f" />
                </desktop:Extension>
                <com:Extension
                    Category="windows.comServer">
                    <com:ComServer>
                        <com:ExeServer Executable="olkPushNotificationBackgroundTask.exe"
                            DisplayName="olkPushNotificationBackgroundTask"
                            Arguments="-StartPushNotificationTask">
                            <com:Class Id="30c84ea2-06e5-44b2-8614-d17d7244e7dc"
                                DisplayName="PushNotificationBackgroundTask" />
                        </com:ExeServer>
                    </com:ComServer>
                </com:Extension>
                <com:Extension
                    Category="windows.comServer">
                    <com:ComServer>
                        <com:ExeServer Executable="olkexthost.exe"
                            DisplayName="Outlook Extensions Host"
                            Arguments="-Embedded">
                            <com:Class Id="FB5A00AE-274F-4B55-A3F0-BBE264A22BAA"
                                DisplayName="ExtensionHost" />
                        </com:ExeServer>
                    </com:ComServer>
                </com:Extension>
                 <Extension Category="windows.preInstalledConfigTask"
                    EntryPoint="Microsoft.NativeHost.LowTrustBackgroundTask" />
            </Extensions>
        </Application>
    </Applications>
    <Extensions>
        <Extension
            Category="windows.activatableClass.inProcessServer">
            <InProcessServer>
                <Path>lowTrustBackgroundTask.dll</Path>
                <ActivatableClass
                    ActivatableClassId="Microsoft.NativeHost.LowTrustBackgroundTask"
                    ThreadingModel="both" />
            </InProcessServer>
        </Extension>
    </Extensions>
    <Dependencies>
        <TargetDeviceFamily MaxVersionTested="10.0.26226.0" MinVersion="10.0.19041.0"
            Name="Windows.Desktop" />
