<policyDefinitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <policyNamespaces>
    <target prefix="tabletshell" namespace="Microsoft.Policies.TabletPCShell" />
    <using prefix="windows" namespace="Microsoft.Policies.Windows" />
  </policyNamespaces>
  <resources minRequiredRevision="1.0" />
  <categories>
    <category name="Accessories" displayName="$(string.Accessories)">
      <parentCategory ref="windows:TabletPC" />
    </category>
    <category name="Cursors" displayName="$(string.Cursors)">
      <parentCategory ref="windows:TabletPC" />
    </category>
    <category name="HardwareButtons" displayName="$(string.HardwareButtons)">
      <parentCategory ref="windows:TabletPC" />
    </category>
    <category name="PenFlicksLearning" displayName="$(string.PenFlicksLearning)">
      <parentCategory ref="windows:TabletPC" />
    </category>
    <category name="PenUXBehaviors" displayName="$(string.PenUXBehaviors)">
      <parentCategory ref="windows:TabletPC" />
    </category>
  </categories>
  <policies>
    <policy name="DisableInkball_1" class="User" displayName="$(string.DisableInkball)" explainText="$(string.DisableInkball_Help)" key="SOFTWARE\Policies\Microsoft\TabletPC" valueName="DisableInkball">
      <parentCategory ref="Accessories" />
      <supportedOn ref="windows:SUPPORTED_WindowsVistaOnly" />
      <enabledValue>
        <decimal value="1" />
      </enabledValue>
      <disabledValue>
        <decimal value="0" />
      </disabledValue>
    </policy>
    <policy name="DisableInkball_2" class="Machine" displayName="$(string.DisableInkball)" explainText="$(string.DisableInkball_Help)" key="SOFTWARE\Policies\Microsoft\TabletPC" valueName="DisableInkball">
      <parentCategory ref="Accessories" />
      <supportedOn ref="windows:SUPPORTED_WindowsVistaOnly" />
      <enabledValue>
        <decimal value="1" />
      </enabledValue>
      <disabledValue>
        <decimal value="0" />
      </disabledValue>
    </policy>
    <policy name="DisableJournal_1" class="User" displayName="$(string.DisableJournal)" explainText="$(string.DisableJournal_Help)" key="SOFTWARE\Policies\Microsoft\TabletPC" valueName="DisableJournal">
      <parentCategory ref="Accessories" />
      <supportedOn ref="windows:SUPPORTED_WindowsVista" />
      <enabledValue>
        <decimal value="1" />
      </enabledValue>
      <disabledValue>
        <decimal value="0" />
      </disabledValue>
    </policy>
    <policy name="DisableJournal_2" class="Machine" displayName="$(string.DisableJournal)" explainText="$(string.DisableJournal_Help)" key="SOFTWARE\Policies\Microsoft\TabletPC" valueName="DisableJournal">
      <parentCategory ref="Accessories" />
      <supportedOn ref="windows:SUPPORTED_WindowsVista" />
      <enabledValue>
        <decimal value="1" />
      </enabledValue>
      <disabledValue>
        <decimal value="0" />
      </disabledValue>
    </policy>
    <policy name="DisableNoteWriterPrinting_1" class="User" displayName="$(string.DisableNoteWriterPrinting)" explainText="$(string.DisableNoteWriterPrinting_Help)" key="SOFTWARE\Policies\Microsoft\TabletPC" valueName="DisableNoteWriterPrinting">
      <parentCategory ref="Accessories" />
      <supportedOn ref="windows:SUPPORTED_WindowsVista" />
      <enabledValue>
        <decimal value="1" />
      </enabledValue>
      <disabledValue>
        <decimal value="0" />
      </disabledValue>
    </policy>
    <policy name="DisableNoteWriterPrinting_2" class="Machine" displayName="$(string.DisableNoteWriterPrinting)" explainText="$(string.DisableNoteWriterPrinting_Help)" key="SOFTWARE\Policies\Microsoft\TabletPC" valueName="DisableNoteWriterPrinting">
      <parentCategory ref="Accessories" />
      <supportedOn ref="windows:SUPPORTED_WindowsVista" />
      <enabledValue>
        <decimal value="1" />
      </enabledValue>
      <disabledValue>
        <decimal value="0" />
